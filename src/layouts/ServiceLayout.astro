---
import BaseLayout from './BaseLayout.astro';
import ReferenceBanner from '../components/ReferenceBanner.astro';
import ReferenceContactStrip from '../components/ReferenceContactStrip.astro';
import ServiceCatalogRotator from '../components/ServiceCatalogRotator.astro';
import { breadcrumbSchema, serviceSchema } from '../lib/seo';
interface Props { title:string; metaDescription:string; h1:string; heroLineOne:string; heroLineTwo:string; heroAccent:string; intro:string; canonicalPath:string; serviceType:string; heroImage?:string; }
const { title,metaDescription,h1,intro,canonicalPath,serviceType,heroImage='/images/home/hero-hds-original.png' }=Astro.props;
const showServiceCatalog=canonicalPath==='/transport-hds/';
const relatedLinks=[
  {label:'Transport HDS',href:'/transport-hds/'},
  {label:'Wynajem HDS z operatorem',href:'/wynajem-hds/'},
  {label:'Transport kontenerów',href:'/transport-kontenerow/'},
  {label:'Transport prefabrykatów',href:'/transport-prefabrykatow/'},
  {label:'Transport maszyn',href:'/transport-maszyn/'},
  {label:'Rozładunek HDS',href:'/rozladunek-hds/'}
].filter(link=>link.href!==canonicalPath);
const jsonLd=[
  serviceSchema({name:serviceType,description:metaDescription,path:canonicalPath}),
  breadcrumbSchema([{name:'Start',path:'/'},{name:serviceType,path:canonicalPath}])
];
---
<BaseLayout title={title} description={metaDescription} canonicalPath={canonicalPath} jsonLd={jsonLd}>
  <ReferenceBanner heading={h1} eyebrow={serviceType} description={intro} image={heroImage} breadcrumb={serviceType} />

  <section class="sht-article sht-service-article" aria-label={serviceType}>
    <div class="sht-shell">
      <div class="sht-article-title">
        <span class="sht-small-accent" aria-hidden="true"></span>
        <h2>{serviceType} — zakres prac i przygotowanie</h2>
      </div>
      <div class="sht-article-layout">
        <article class="sht-article-text">
          <p class="sht-article-lead">{intro}</p>
          <div class="sht-prose" data-service-guide><slot /></div>
          <nav class="sht-related" aria-label="Powiązane usługi KALTRUCK">
            <h3>Sprawdź pozostałe usługi HDS</h3>
            <div>{relatedLinks.map(link=><a href={link.href}>{link.label} <span aria-hidden="true">›</span></a>)}</div>
          </nav>
        </article>
        <aside class="sht-service-side" aria-label="Informacje o realizacji">
          <div class="sht-article-aside">
            <img src={heroImage} alt={`Realizacja KALTRUCK — ${serviceType}`} width="1440" height="1080" loading="lazy" decoding="async" />
            <div class="sht-article-aside-note">
              <span>TRANSPORT / PODNOSZENIE / USTAWIENIE</span>
              <p>Usługi HDS dopasowane do parametrów ładunku i warunków miejsca dostawy.</p>
            </div>
          </div>
          <div class="sht-side-facts">
            <h3>Możliwości KALTRUCK</h3>
            <div><strong>12 t</strong><span>udźwig HDS do</span></div>
            <div><strong>14 m</strong><span>zasięg ramienia do</span></div>
            <a href="/wycena/">ZAPYTAJ O REALIZACJĘ <span aria-hidden="true">›</span></a>
            <a href="/realizacje/">ZOBACZ REALIZACJE <span aria-hidden="true">›</span></a>
          </div>
        </aside>
      </div>
    </div>
  </section>
  {showServiceCatalog && (
    <section class="sht-catalog-area" aria-label="Pełna lista usług KALTRUCK">
      <div class="sht-shell">
        <div class="sht-article-title"><span class="sht-small-accent" aria-hidden="true"></span><h2>Pełny zakres obsługiwanych ładunków</h2></div>
        <ServiceCatalogRotator />
      </div>
    </section>
  )}
  <ReferenceContactStrip />
</BaseLayout>