---
import '../styles/global.css';
import { siteConfig } from '../config/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { organizationSchema } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  image?: string;
  noindex?: boolean;
  jsonLd?: unknown | unknown[];
}

const { title, description, canonicalPath, image = siteConfig.socialImage, noindex = false, jsonLd = [] } = Astro.props;
const schemas = [organizationSchema(), ...(Array.isArray(jsonLd) ? jsonLd : [jsonLd])].filter(Boolean);
const canonical = new URL(canonicalPath, siteConfig.siteUrl).toString();
const socialImage = new URL(image, siteConfig.siteUrl).toString();
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0b0c" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.brandName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {schemas.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Przejdź do treści</a>
    <Header />
    <main id="main-content"><slot /></main>
    <Footer />
  </body>
</html>
