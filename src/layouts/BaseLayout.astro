---
import '../styles/global.css';
import { siteConfig } from '../config/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { organizationSchema } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  image?: string;
  noindex?: boolean;
  jsonLd?: unknown | unknown[];
}

const { title, description, canonicalPath, image = siteConfig.socialImage, noindex = false, jsonLd = [] } = Astro.props;
const schemas = [organizationSchema(), ...(Array.isArray(jsonLd) ? jsonLd : [jsonLd])].filter(Boolean);
const canonical = new URL(canonicalPath, siteConfig.siteUrl).toString();
const socialImage = new URL(image, siteConfig.siteUrl).toString();
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0b0c" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.brandName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {schemas.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Przejdź do treści</a>
    <Header />
    <main id="main-content"><slot /></main>
    <Footer />

    <script is:inline>
      (() => {
        const image = document.querySelector('[data-project-lightbox-image]');
        if (!(image instanceof HTMLImageElement)) return;

        const lightbox = image.closest('[data-project-lightbox]');
        if (!(lightbox instanceof HTMLElement)) return;

        const fitImage = () => {
          if (lightbox.hidden || !image.naturalWidth || !image.naturalHeight) return;

          const compact = window.matchMedia('(max-width: 900px)').matches;
          const maxWidth = compact
            ? Math.max(1, window.innerWidth - 20)
            : Math.max(1, Math.min(1380, window.innerWidth - 150));
          const maxHeight = compact
            ? Math.max(1, window.innerHeight - 175)
            : Math.max(1, window.innerHeight - 165);
          const scale = Math.min(maxWidth / image.naturalWidth, maxHeight / image.naturalHeight);

          image.style.width = `${image.naturalWidth * scale}px`;
          image.style.height = `${image.naturalHeight * scale}px`;

          requestAnimationFrame(() => {
            const figure = image.closest('[data-project-lightbox-figure]');
            const overlay = lightbox.querySelector('[data-project-lightbox-overlay]');
            if (!(figure instanceof HTMLElement) || !(overlay instanceof HTMLElement)) return;
            const figureRect = figure.getBoundingClientRect();
            const imageRect = image.getBoundingClientRect();
            overlay.style.left = `${Math.max(0, imageRect.left - figureRect.left)}px`;
            overlay.style.top = `${Math.max(0, imageRect.top - figureRect.top)}px`;
            overlay.style.width = `${imageRect.width}px`;
            overlay.style.height = `${imageRect.height}px`;
          });
        };

        image.addEventListener('load', fitImage);
        window.addEventListener('resize', fitImage);

        const observer = new MutationObserver(() => requestAnimationFrame(fitImage));
        observer.observe(lightbox, { attributes: true, attributeFilter: ['hidden'] });
        observer.observe(image, { attributes: true, attributeFilter: ['src'] });

        fitImage();
      })();
    </script>
  </body>
</html>
