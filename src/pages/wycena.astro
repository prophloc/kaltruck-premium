---
import BaseLayout from '../layouts/BaseLayout.astro';
import ReferenceBanner from '../components/ReferenceBanner.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { siteConfig } from '../config/site';
---
<BaseLayout title="Wycena transportu HDS | KALTRUCK" description="Wyślij dane ładunku i trasy, aby otrzymać wycenę transportu, załadunku, rozładunku lub montażu HDS." canonicalPath="/wycena/">
  <ReferenceBanner heading="Wycena transportu HDS" breadcrumb="WYCENA" description="Opisz ładunek i trasę. Skontaktujemy się w sprawie możliwości realizacji." />
  <section class="sht-article sht-quote-page">
    <div class="sht-shell">
      <div class="sht-article-title"><span class="sht-small-accent"></span><h2>Zapytanie o transport i rozładunek</h2></div>
      <div class="sht-quote-grid">
        <div class="sht-quote-primary">
          <p class="sht-quote-lead">Podaj rodzaj ładunku, szacowaną masę i wymiary oraz miejsca odbioru i dostawy. Im dokładniej opiszesz warunki, tym łatwiej dobrać odpowiedni HDS.</p>
          <QuoteForm layout="stacked" />
        </div>
        <aside class="sht-quote-info">
          <h3>Co warto przygotować?</h3>
          <ul>
            <li>Rodzaj ładunku i jego gabaryty</li>
            <li>Szacowaną masę</li>
            <li>Adres odbioru i miejsce ustawienia</li>
            <li>Termin oraz warunki dojazdu</li>
            <li>Zdjęcia miejsca pracy, jeśli są dostępne</li>
          </ul>
          <div class="sht-quote-help">
            <strong>Wolisz zadzwonić?</strong>
            <a href={`tel:${siteConfig.phone}`}>+48 784 430 022</a>
            <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>