---
import BaseLayout from '../layouts/BaseLayout.astro';
import QuoteForm from '../components/QuoteForm.astro';
---
<BaseLayout title="Wycena transportu HDS | KALTRUCK" description="Wyślij dane ładunku i trasy, aby otrzymać wycenę transportu, załadunku, rozładunku lub montażu HDS." canonicalPath="/wycena/">
<section class="quote-page section"><div class="container"><div class="quote-head"><div><p class="eyebrow">Szybka wycena</p><h1>Co przewozimy<br/>i gdzie ma stanąć?</h1></div><p class="lead">Podaj podstawowe informacje. Im dokładniej znamy ładunek i warunki na miejscu, tym szybciej możemy ocenić realizację.</p></div><div class="form-wrap"><QuoteForm /></div></div></section>
</BaseLayout>
<style>.quote-page{padding-top:calc(var(--header-height) + clamp(76px,8vw,118px))}.quote-head{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:var(--grid-gap);align-items:end}.quote-head>div{grid-column:1/span 8}.quote-head>.lead{grid-column:9/span 4;margin:0 0 8px}.quote-page h1{font-size:clamp(3.5rem,7vw,7.2rem);line-height:.89;letter-spacing:-.055em;margin:18px 0 0;max-width:10ch}.form-wrap{margin-top:clamp(52px,6vw,82px);padding-top:clamp(34px,4vw,48px);border-top:1px solid var(--line)}@media(max-width:800px){.quote-head{grid-template-columns:1fr;gap:28px}.quote-head>div,.quote-head>.lead{grid-column:1}.quote-page h1{font-size:clamp(3rem,12vw,5rem)}}</style>
