---
import { getEntry, render } from 'astro:content';
import ServiceLayout from '../layouts/ServiceLayout.astro';
const entry = await getEntry('services', 'rozladunek-hds');
if (!entry) throw new Error('Missing service content: rozladunek-hds');
const { Content } = await render(entry);
---
<ServiceLayout {...entry.data} canonicalPath="/rozladunek-hds/"><Content /></ServiceLayout>
