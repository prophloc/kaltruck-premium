---
import { siteConfig } from '../config/site';
import { organizationSchema } from '../lib/seo';
const title = 'Transport HDS Płock | KALTRUCK — kontenery, maszyny, prefabrykaty';
const description = 'KALTRUCK — transport HDS z Płocka: transport, załadunek, rozładunek oraz ustawienie kontenerów, prefabrykatów i maszyn. Realizacje w całej Polsce.';
const canonical = new URL('/', siteConfig.siteUrl).toString();
const socialImage = new URL(siteConfig.socialImage, siteConfig.siteUrl).toString();
---
<!doctype html>
<html lang="pl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="theme-color" content="#f6fbff" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="KALTRUCK" />
  <meta property="og:locale" content="pl_PL" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={socialImage} />
  <meta property="og:image:secure_url" content={socialImage} />
  <meta property="og:image:type" content="image/jpeg" />
  <meta property="og:image:width" content="1000" />
  <meta property="og:image:height" content="525" />
  <meta property="og:image:alt" content="KALTRUCK – transport i usługi HDS" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="preload" href="/images/home/hero-hds-desktop.webp" as="image" media="(min-width: 861px)" />
  <link rel="preload" href="/images/home/hero-hds-mobile.webp" as="image" media="(max-width: 860px)" />
  <link rel="stylesheet" href="/dieglanzies-kaltruck.css" />
  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema())}/>
</head>
<body>
  <a href="#main-content" class="skip-link">Przejdź do treści</a>
  <main class="page" id="main-content">
    <section class="hero" id="start">
      <div class="hero-overlay"></div>
      <header class="topbar">
        <a class="brand" href="/" aria-label="KALTRUCK — strona główna">
          <img src="/brand/kaltruck-logo.svg" width="2548" height="1305" alt="" class="brand-icon brand-logo" />
          <span class="brand-text"><strong><span>KAL</span>TRUCK</strong><small>TRANSPORT I USŁUGI HDS</small></span>
        </a>
        <nav class="nav" aria-label="Nawigacja">
          <a href="#angebot">Oferta</a>
          <a href="/realizacje/">Realizacje</a>
          <a href="#kontakt">Kontakt</a>
          <a class="nav-cta" href="/wycena/">Wyceń transport <span aria-hidden="true">›</span></a>
        </nav>
      </header>

      <div class="hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">PROFESJONALNY TRANSPORT HDS</p>
          <h1 class="main-title" aria-label="Kontenery, maszyny i inne ciężkie ładunki — transport HDS">
            <span class="sticker word-blue">Kontenery</span>
            <span class="sticker word-green">Maszyny</span>
            <span class="sub-sticker">i wiele innych ładunków</span>
          </h1>
          <p class="lead">
            Transportujemy, podnosimy i ustawiamy ciężkie ładunki z wykorzystaniem
            <strong class="blue">transportu HDS</strong> i <strong class="green">żurawia</strong>.
            Od kontenerów po prefabrykaty, urządzenia i maszyny — sprawnie od załadunku do ustawienia.
          </p>
          <div class="badges">
            <a href="/sprzet/" class="badge badge-price"><span class="badge-icon" aria-hidden="true">◆</span> HDS o udźwigu do 12 ton</a>
            <a href="#anfahrt" class="badge badge-bus"><span class="badge-icon" aria-hidden="true">▰</span> Płock i cała Polska</a>
          </div>
          <div class="contact-pills">
            <a href={`tel:${siteConfig.phone}`} class="badge badge-phone"><span class="badge-icon" aria-hidden="true">☎</span> +48 784 430 022</a>
            <a href={`mailto:${siteConfig.email}`} class="badge badge-mail"><span class="badge-icon" aria-hidden="true">✉</span> {siteConfig.email}</a>
          </div>
        </div>
        <div class="hero-cards" aria-label="Karuzela usług HDS">
          <div class="cards-stage" id="cardsStage" aria-live="polite"></div>
          <div class="service-slider-wrap" id="angebot">
            <button class="slider-btn" id="prevBtn" type="button" aria-label="Poprzednia usługa">←</button>
            <button class="active-service-box" id="activeServiceBox" type="button" aria-label="Następna usługa">
              <strong id="activeServiceTitle">Transport kontenerów</strong>
            </button>
            <button class="slider-btn" id="nextBtn" type="button" aria-label="Następna usługa">→</button>
          </div>
          <div class="slider-dots-row"><div class="dots" id="dots" aria-label="Wybierz usługę"></div></div>
        </div>
      </div>

      <div class="features">
        <article class="feature-card"><span class="feature-icon blue-icon" aria-hidden="true">✓</span><div><h3>Transport i HDS</h3><p>Załadunek, przewóz i precyzyjne ustawienie jednym zestawem.</p></div></article>
        <article class="feature-card"><span class="feature-icon green-icon" aria-hidden="true">⌖</span><div><h3>Precyzyjny rozładunek</h3><p>Ustawiamy ładunek tam, gdzie pozwalają warunki i możliwości HDS.</p></div></article>
        <article class="feature-card"><span class="feature-icon blue-icon" aria-hidden="true">⏱</span><div><h3>Sprawna realizacja</h3><p>Konkretny plan transportu i organizacja prac na miejscu.</p></div></article>
        <article class="feature-card"><span class="feature-icon green-icon" aria-hidden="true">✦</span><div><h3>Płock i cała Polska</h3><p>Transport lokalny i dalsze trasy zależnie od zakresu zlecenia.</p></div></article>
      </div>
    </section>
    <section class="details-section" aria-labelledby="offer-title">
      <div class="section-head">
        <p class="eyebrow">NASZA OFERTA</p>
        <h2 id="offer-title">Przewieziemy i ustawimy to, co ważne.</h2>
        <p>Transport z żurawiem HDS dla budownictwa, przemysłu i klientów indywidualnych. Zobacz najczęściej realizowane usługi.</p>
      </div>
      <div class="offer-grid">
        <a href="/transport-kontenerow/"><article><h3>Transport kontenerów</h3><p>Kontenery biurowe, magazynowe i mieszkalne — przewóz, rozładunek i ustawienie.</p><span class="offer-arrow">Poznaj usługę ↗</span></article></a>
        <a href="/transport-prefabrykatow/"><article><h3>Transport prefabrykatów</h3><p>Prefabrykaty betonowe, konstrukcje stalowe i ciężkie elementy budowlane.</p><span class="offer-arrow">Poznaj usługę ↗</span></article></a>
        <a href="/transport-maszyn/"><article><h3>Transport maszyn</h3><p>Przemysłowe urządzenia, maszyny oraz specjalistyczne ładunki wymagające HDS.</p><span class="offer-arrow">Poznaj usługę ↗</span></article></a>
      </div>
    </section>
    <section class="contact-section" id="kontakt">
      <div class="contact-card">
        <p class="eyebrow">KONTAKT / WYCENA HDS</p>
        <h2>Zapytaj o transport</h2>
        <p>Wyślij informacje o ładunku, jego wadze, wymiarach oraz miejscu odbioru i ustawienia. Ocenimy możliwości realizacji i przygotujemy wycenę.</p>
        <div class="contact-actions">
          <a href="/wycena/" class="contact-main">Formularz wyceny ↗</a>
          <a href={`tel:${siteConfig.phone}`}>+48 784 430 022</a>
          <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
          <a href="/realizacje/">Nasze realizacje</a>
        </div>
      </div>
      <div class="contact-side" id="anfahrt">
        <img src="/brand/kaltruck-logo.svg" width="2548" height="1305" alt="Logo KALTRUCK" />
        <h3>Transport HDS z Płocka na terenie całej Polski.</h3>
        <p>Łączymy transport, podnoszenie i ustawianie ładunków. <a href="/sprzet/" style="color:#078ee8">Poznaj możliwości naszego sprzętu ↗</a></p>
      </div>
    </section>
  </main>
  <footer class="footer-line">
    <span>© {new Date().getFullYear()} {siteConfig.legalName} · NIP {siteConfig.nip} · {siteConfig.baseAddress}</span>
    <a href="/kontakt/">Pełne dane kontaktowe</a>
  </footer>
  <script defer src="/dieglanzies-kaltruck.js"></script>
</body>
</html>