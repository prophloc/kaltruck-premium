---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectGallery from '../components/ProjectGallery.astro';
import CTASection from '../components/CTASection.astro';

const projects = await getCollection('realizations');

const sourceCategories = [
  'Transport i montaż konstrukcji',
  'Budownictwo i infrastruktura',
  'Energetyka i przemysł',
  'Rolnictwo i rekreacja',
  'Reklama i wydarzenia',
] as const;

const projectGroup = (project: (typeof projects)[number]) => {
  const text = `${project.data.category} ${project.data.title}`.toLocaleLowerCase('pl');
  if (/rolnic|silos|siano|traw|łod|lod|jacht|gołęb|goleb/.test(text)) return 'Rolnictwo i rekreacja';
  if (/reklam|billboard|paczkomat|event|imprez/.test(text)) return 'Reklama i wydarzenia';
  if (/kontener|holender|suwnic|stacj.*ładow/.test(text)) return 'Transport i montaż konstrukcji';
  if (/prefab|budow|szkielet|płyt|plyt|ogrodz|ekran|kład|klad|wiadukt|ruszt|szalunk|big-bag/.test(text)) return 'Budownictwo i infrastruktura';
  return 'Energetyka i przemysł';
};

const heroCategories = sourceCategories.map((category) => {
  const project = projects.find((item) => projectGroup(item) === category) ?? projects[0];
  return { category, project };
});
---
<BaseLayout title="Realizacje HDS | KALTRUCK Kalwasińscy" description="Zobacz autentyczne realizacje KALTRUCK: kontenery, prefabrykaty, urządzenia przemysłowe, konstrukcje i nietypowe ładunki obsługiwane HDS." canonicalPath="/realizacje/">
  <section class="page-head section">
    <div class="container page-head-grid">
      <div class="page-head-copy">
        <p class="eyebrow">Realizacje</p>
        <h1>Robota mówi<br />więcej niż obietnice.</h1>
      </div>

      <aside class="realization-category-preview" aria-label="Kategorie realizacji">
        <p class="preview-intro">Wybrane realizacje z prawdziwych zleceń Transport HDS Kalwasińscy.</p>
        <div class="realization-category-grid">
          {heroCategories.map(({ category, project }, index) => (
            <button
              class:list={['realization-category-card', index === heroCategories.length - 1 && 'realization-category-card--wide']}
              type="button"
              data-realization-category-card={category}
              aria-label={`Pokaż realizacje: ${category}`}
            >
              <img
                src={project.data.image}
                alt=""
                width={project.data.width}
                height={project.data.height}
                loading="eager"
                aria-hidden="true"
              />
              <span>{category}</span>
            </button>
          ))}
        </div>
      </aside>
    </div>
  </section>

  <section class="section gallery-section">
    <div class="container"><ProjectGallery projects={projects} /></div>
  </section>
  <CTASection />
</BaseLayout>

<script is:inline>
  (() => {
    const cards = [...document.querySelectorAll('[data-realization-category-card]')];
    cards.forEach((card) => {
      card.addEventListener('click', () => {
        const category = card.getAttribute('data-realization-category-card');
        if (!category) return;
        const filter = [...document.querySelectorAll('[data-project-filter]')]
          .find((button) => button.getAttribute('data-project-filter') === category);
        if (filter instanceof HTMLElement) filter.click();

        const gallery = document.querySelector('[data-project-gallery]');
        if (gallery) {
          const headerHeight = document.querySelector('header')?.getBoundingClientRect().height ?? 84;
          const targetTop = gallery.getBoundingClientRect().top + window.scrollY - headerHeight - 18;
          window.scrollTo(0, Math.max(0, targetTop));
        }
      });
    });
  })();
</script>

<style>
  .page-head{padding-top:calc(var(--header-height) + clamp(74px,8vw,118px));padding-bottom:clamp(52px,6vw,82px)}
  .page-head-grid{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:var(--grid-gap);align-items:end}
  .page-head-copy{grid-column:1/span 8}
  .page-head h1{font-size:clamp(3.7rem,7.6vw,7.8rem);line-height:.88;letter-spacing:-.058em;margin:18px 0 0;max-width:9.5ch}

  .realization-category-preview{grid-column:9/-1;display:grid;gap:18px;align-self:end;min-width:0}
  .preview-intro{margin:0;color:#c6c1b8;font-size:clamp(.88rem,1vw,1rem);line-height:1.55;max-width:31ch}
  .realization-category-grid{display:grid;grid-template-columns:1fr 1fr;gap:9px}
  .realization-category-card{position:relative;isolation:isolate;overflow:hidden;min-height:82px;padding:0;border:1px solid rgba(255,255,255,.1);border-radius:12px;background:#121416;color:#fff;text-align:left;cursor:pointer;transition:transform .22s ease,border-color .22s ease}
  .realization-category-card--wide{grid-column:1/-1;min-height:76px}
  .realization-category-card img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:saturate(.72) brightness(.62);transition:transform .35s ease,filter .35s ease}
  .realization-category-card::after{content:'';position:absolute;inset:0;z-index:0;background:linear-gradient(180deg,rgba(6,7,8,.08) 0%,rgba(6,7,8,.3) 44%,rgba(6,7,8,.88) 100%)}
  .realization-category-card span{position:absolute;z-index:1;left:11px;right:10px;bottom:9px;font-size:.68rem;font-weight:760;line-height:1.12;letter-spacing:-.01em;text-shadow:0 1px 8px rgba(0,0,0,.65)}
  .realization-category-card:hover{transform:translateY(-2px);border-color:rgba(215,180,106,.46)}
  .realization-category-card:hover img{transform:scale(1.045);filter:saturate(.9) brightness(.72)}
  .realization-category-card:focus-visible{outline:2px solid var(--accent);outline-offset:2px}

  .gallery-section{padding-top:12px;scroll-margin-top:calc(var(--header-height) + 18px)}

  @media(max-width:980px){
    .page-head-copy{grid-column:1/span 7}
    .realization-category-preview{grid-column:8/-1}
    .realization-category-card{min-height:78px}
    .realization-category-card span{font-size:.64rem}
  }

  @media(max-width:800px){
    .page-head-grid{grid-template-columns:1fr;gap:34px;align-items:start}
    .page-head-copy,.realization-category-preview{grid-column:1}
    .page-head h1{font-size:clamp(3.3rem,13vw,5.4rem);max-width:10ch}
    .realization-category-preview{width:100%;gap:14px}
    .preview-intro{max-width:42ch}
    .realization-category-grid{display:flex;overflow-x:auto;gap:9px;padding:2px 2px 8px;scroll-snap-type:x proximity;scrollbar-width:none}
    .realization-category-grid::-webkit-scrollbar{display:none}
    .realization-category-card,.realization-category-card--wide{flex:0 0 min(70vw,260px);min-height:96px;grid-column:auto;scroll-snap-align:start}
    .realization-category-card span{font-size:.72rem}
  }
</style>
