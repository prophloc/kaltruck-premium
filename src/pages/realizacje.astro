---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ReferenceBanner from '../components/ReferenceBanner.astro';
import ProjectGallery from '../components/ProjectGallery.astro';


const projects = await getCollection('realizations');

const sourceCategories = [
  'Transport i montaż konstrukcji',
  'Budownictwo i infrastruktura',
  'Energetyka i przemysł',
  'Rolnictwo i rekreacja',
  'Reklama i wydarzenia',
] as const;

const projectGroup = (project: (typeof projects)[number]) => {
  const text = `${project.data.category} ${project.data.title}`.toLocaleLowerCase('pl');
  if (/rolnic|silos|siano|traw|łod|lod|jacht|gołęb|goleb/.test(text)) return 'Rolnictwo i rekreacja';
  if (/reklam|billboard|paczkomat|event|imprez/.test(text)) return 'Reklama i wydarzenia';
  if (/kontener|holender|suwnic|stacj.*ładow/.test(text)) return 'Transport i montaż konstrukcji';
  if (/prefab|budow|szkielet|płyt|plyt|ogrodz|ekran|kład|klad|wiadukt|ruszt|szalunk|big-bag/.test(text)) return 'Budownictwo i infrastruktura';
  return 'Energetyka i przemysł';
};

const sortedProjects = [...projects].sort((a, b) => a.id.localeCompare(b.id, 'pl'));
const heroProjects = sourceCategories.flatMap((category) => {
  const project = sortedProjects.find((item) => projectGroup(item) === category);
  return project ? [{ project, category }] : [];
});
---
<BaseLayout title="Realizacje HDS | KALTRUCK Kalwasińscy" description="Zobacz autentyczne realizacje KALTRUCK: kontenery, prefabrykaty, urządzenia przemysłowe, konstrukcje i nietypowe ładunki obsługiwane HDS." canonicalPath="/realizacje/">
  <ReferenceBanner heading="Realizacje transportu HDS" breadcrumb="REALIZACJE" description="Zdjęcia rzeczywistych zleceń KALTRUCK — kontenery, prefabrykaty, maszyny i transport specjalistyczny." />
  <section class="sht-article sht-projects-section" aria-labelledby="sht-projects-heading">
    <div class="sht-shell">
      <div class="sht-article-title"><span class="sht-small-accent"></span><h2 id="sht-projects-heading">Nasze realizacje</h2></div>
      <p class="sht-projects-intro">Wybierz rodzaj transportu lub przejdź bezpośrednio do galerii. Wszystkie zdjęcia przedstawiają rzeczywiste realizacje HDS Kalwasińscy.</p>
      <nav class="sht-project-category-grid" aria-label="Wybierz kategorię realizacji">
        {heroProjects.map(({project,category})=>(
          <a class="sht-project-category" href="#realization-gallery" data-realization-project-card={project.id} data-realization-category={category} aria-label={`Pokaż kategorię: ${category}`}>
            <img src={project.data.image} alt="" width={project.data.width} height={project.data.height} loading="lazy" />
            <span>{category}</span>
          </a>
        ))}
      </nav>
      <div id="realization-gallery" class="sht-project-gallery"><ProjectGallery projects={sortedProjects} /></div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (() => {
    const cards = [...document.querySelectorAll('[data-realization-project-card]')];
    cards.forEach((card) => {
      card.addEventListener('click', () => {
        const category = card.getAttribute('data-realization-category');
        if (!category) return;
        const filter = [...document.querySelectorAll('[data-project-filter]')]
          .find((button) => button.getAttribute('data-project-filter') === category);
        if (filter instanceof HTMLElement) filter.click();
      });
    });
  })();
</script>

