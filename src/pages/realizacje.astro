---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectGallery from '../components/ProjectGallery.astro';
import CTASection from '../components/CTASection.astro';

const projects = await getCollection('realizations');

const sourceCategories = [
  'Transport i montaż konstrukcji',
  'Budownictwo i infrastruktura',
  'Energetyka i przemysł',
  'Rolnictwo i rekreacja',
  'Reklama i wydarzenia',
] as const;

const projectGroup = (project: (typeof projects)[number]) => {
  const text = `${project.data.category} ${project.data.title}`.toLocaleLowerCase('pl');
  if (/rolnic|silos|siano|traw|łod|lod|jacht|gołęb|goleb/.test(text)) return 'Rolnictwo i rekreacja';
  if (/reklam|billboard|paczkomat|event|imprez/.test(text)) return 'Reklama i wydarzenia';
  if (/kontener|holender|suwnic|stacj.*ładow/.test(text)) return 'Transport i montaż konstrukcji';
  if (/prefab|budow|szkielet|płyt|plyt|ogrodz|ekran|kład|klad|wiadukt|ruszt|szalunk|big-bag/.test(text)) return 'Budownictwo i infrastruktura';
  return 'Energetyka i przemysł';
};

const sortedProjects = [...projects].sort((a, b) => a.id.localeCompare(b.id, 'pl'));
const heroProjects = sourceCategories.flatMap((category) => {
  const project = sortedProjects.find((item) => projectGroup(item) === category);
  return project ? [{ project, category }] : [];
});
---
<BaseLayout title="Realizacje HDS | KALTRUCK Kalwasińscy" description="Zobacz autentyczne realizacje KALTRUCK: kontenery, prefabrykaty, urządzenia przemysłowe, konstrukcje i nietypowe ładunki obsługiwane HDS." canonicalPath="/realizacje/">
  <section class="page-head section">
    <div class="container page-head-grid">
      <div class="page-head-copy">
        <p class="eyebrow">Realizacje</p>
        <h1>Robota mówi<br />więcej niż obietnice.</h1>
      </div>

      <aside class="realization-category-preview" aria-label="Realizacje w skrócie">
        <p class="preview-intro">Realizacje z prawdziwych zleceń Transport HDS Kalwasińscy.</p>
        <div class="realization-category-grid">
          {heroProjects.map(({ project, category }) => (
            <a
              class="realization-category-card"
              href="#realization-gallery"
              data-realization-project-card={project.id}
              data-realization-category={category}
              aria-label={`Pokaż kategorię: ${category}`}
            >
              <img
                src={project.data.image}
                alt=""
                width={project.data.width}
                height={project.data.height}
                loading="eager"
                aria-hidden="true"
              />
              <span>{category}</span>
            </a>
          ))}
        </div>
      </aside>
    </div>
  </section>

  <section class="section gallery-section" id="realization-gallery">
    <div class="container"><ProjectGallery projects={projects} /></div>
  </section>
  <CTASection />
</BaseLayout>

<script is:inline>
  (() => {
    const cards = [...document.querySelectorAll('[data-realization-project-card]')];
    cards.forEach((card) => {
      card.addEventListener('click', () => {
        const category = card.getAttribute('data-realization-category');
        if (!category) return;
        const filter = [...document.querySelectorAll('[data-project-filter]')]
          .find((button) => button.getAttribute('data-project-filter') === category);
        if (filter instanceof HTMLElement) filter.click();
      });
    });
  })();
</script>

<style>
  .page-head{padding-top:calc(var(--header-height) + clamp(74px,8vw,118px));padding-bottom:clamp(52px,6vw,82px)}
  .page-head-grid{position:relative;display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:var(--grid-gap);align-items:end}
  .page-head-copy{grid-column:1/span 8;transform:translateX(7.5%)}
  .page-head h1{font-size:clamp(3.7rem,7.6vw,7.8rem);line-height:.88;letter-spacing:-.058em;margin:18px 0 0;max-width:9.5ch}

  .realization-category-preview{position:absolute;left:45%;top:50%;width:50%;transform:translateY(-50%);display:grid;gap:14px;padding-left:clamp(28px,3.2vw,52px);min-width:0}
  .preview-intro{margin:0;color:#c6c1b8;font-size:clamp(.88rem,1vw,1rem);line-height:1.5;max-width:34ch}
  .realization-category-grid{display:grid;grid-template-columns:1fr 1fr;gap:9px}
  .realization-category-card{position:relative;isolation:isolate;overflow:hidden;display:block;min-height:108px;padding:0;border:1px solid rgba(255,255,255,.1);border-radius:12px;background:#121416;color:#fff;text-align:left;text-decoration:none;cursor:pointer;transition:transform .22s ease,border-color .22s ease}
  .realization-category-card img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:saturate(.88) brightness(.82);transition:transform .35s ease,filter .35s ease}
  .realization-category-card::after{content:'';position:absolute;inset:0;z-index:0;background:linear-gradient(180deg,rgba(6,7,8,.04) 0%,rgba(6,7,8,.12) 100%)}
  .realization-category-card span{position:absolute;z-index:1;left:0;right:0;top:50%;transform:translateY(-50%);display:flex;align-items:center;justify-content:center;min-height:38px;padding:8px 12px;background:rgba(9,11,13,.28);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);border-top:1px solid rgba(255,255,255,.08);border-bottom:1px solid rgba(255,255,255,.08);font-size:calc(.82rem + 2px);font-weight:760;line-height:1.15;letter-spacing:-.01em;text-align:center;text-shadow:0 1px 6px rgba(0,0,0,.45)}
  .realization-category-card:hover{transform:translateY(-2px);border-color:rgba(215,180,106,.46)}
  .realization-category-card:hover img{transform:scale(1.045);filter:saturate(.98) brightness(.92)}
  .realization-category-card:focus-visible{outline:2px solid var(--accent);outline-offset:2px}

  .gallery-section{padding-top:12px;scroll-margin-top:calc(var(--header-height) + 18px)}

  @media(max-width:1050px){
    .page-head-copy{grid-column:1/span 7;transform:none}
    .realization-category-preview{left:auto;right:0;width:44%;padding-left:20px}
    .realization-category-card{min-height:92px}
    .realization-category-card span{min-height:34px;padding:7px 10px;font-size:calc(.72rem + 2px)}
  }

  @media(max-width:800px){
    .page-head-grid{grid-template-columns:1fr;gap:34px;align-items:start}
    .page-head-copy{grid-column:1}
    .page-head h1{font-size:clamp(3.3rem,13vw,5.4rem);max-width:10ch}
    .realization-category-preview{position:static;transform:none;width:100%;padding-left:0;display:grid;gap:14px}
    .preview-intro{max-width:42ch}
    .realization-category-grid{display:flex;overflow-x:auto;gap:9px;padding:2px 2px 8px;scroll-snap-type:x proximity;scrollbar-width:none}
    .realization-category-grid::-webkit-scrollbar{display:none}
    .realization-category-card{flex:0 0 min(70vw,270px);min-height:104px;scroll-snap-align:start}
    .realization-category-card span{min-height:40px;font-size:calc(.78rem + 2px)}
  }
</style>
