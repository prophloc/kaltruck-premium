---
import BaseLayout from '../layouts/BaseLayout.astro';
import ReferenceBanner from '../components/ReferenceBanner.astro';
import { siteConfig } from '../config/site';
import DistanceEstimator from '../components/DistanceEstimator.astro';
---
<BaseLayout title="Kontakt KALTRUCK | Transport HDS" description="Skontaktuj się z KALTRUCK w sprawie transportu HDS, rozładunku lub montażu. Telefon, e-mail i szybkie przejście do wyceny." canonicalPath="/kontakt/">
  <ReferenceBanner heading="Kontakt z KALTRUCK" breadcrumb="KONTAKT" description="Zadzwoń lub opisz ładunek i trasę. Pomożemy ustalić możliwości transportu HDS." />
  <section class="sht-article sht-contact-page">
    <div class="sht-shell">
      <div class="sht-article-title"><span class="sht-small-accent"></span><h2>Skontaktuj się z nami</h2></div>
      <div class="sht-contact-grid">
        <div class="sht-contact-item"><span class="sht-contact-icon">☎</span><div><h3>Telefon</h3><p>Bezpośredni kontakt w sprawie transportu</p><a href={`tel:${siteConfig.phone}`}>+48 784 430 022</a></div></div>
        <div class="sht-contact-item"><span class="sht-contact-icon">✉</span><div><h3>E-mail</h3><p>Prześlij zapytanie z danymi ładunku</p><a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a></div></div>
        <div class="sht-contact-item"><span class="sht-contact-icon">⌖</span><div><h3>Adres</h3><p>Baza transportowa KALTRUCK</p><a href={siteConfig.googleMapsUrl} target="_blank" rel="noopener noreferrer">{siteConfig.baseAddress}</a></div></div>
      </div>
      <div class="sht-contact-page-cta">
        <div><h2>Potrzebujesz wyceny?</h2><p>Podaj skąd i dokąd jedzie ładunek, jego masę i wymiary oraz warunki na miejscu.</p></div>
        <a href="/wycena/">PRZEJDŹ DO FORMULARZA <span aria-hidden="true">›</span></a>
      </div>
      <div class="sht-route-page">
        <div class="sht-article-title"><span class="sht-small-accent"></span><h2>Sprawdź trasę transportu</h2></div>
        <DistanceEstimator instanceId="contact-route" />
      </div>
    </div>
  </section>
</BaseLayout>