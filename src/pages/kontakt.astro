---
import BaseLayout from '../layouts/BaseLayout.astro'; import { siteConfig } from '../config/site';
---
<BaseLayout title="Kontakt KALTRUCK | Transport HDS" description="Skontaktuj się z KALTRUCK w sprawie transportu HDS, rozładunku lub montażu. Telefon, e-mail i szybkie przejście do wyceny." canonicalPath="/kontakt/">
<section class="contact section"><div class="container"><p class="eyebrow">Kontakt</p><h1>Powiedz, co trzeba<br/>podnieść i przewieźć.</h1><div class="contact-grid"><div><span>Telefon</span><a href={`tel:${siteConfig.phone}`}>+48 514 948 373</a><a href={`tel:${siteConfig.secondaryPhone}`}>+48 784 430 022</a></div><div><span>E-mail</span><a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a></div><div><span>Wycena</span><a class="btn btn-primary" href="/wycena/">Przejdź do formularza wyceny</a></div></div></div></section>
</BaseLayout>
<style>.contact{padding-top:calc(var(--header-height) + 110px);min-height:80svh}.contact h1{font-size:clamp(3.5rem,8vw,8.6rem);line-height:.9;letter-spacing:-.055em;margin:18px 0 72px}.contact-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;border-top:1px solid var(--line);padding-top:30px}.contact-grid>div{display:grid;gap:8px}.contact-grid span{font-size:.72rem;color:var(--muted);text-transform:uppercase;letter-spacing:.14em}.contact-grid a:not(.btn){font-size:clamp(1.2rem,2.4vw,2rem)}@media(max-width:760px){.contact-grid{grid-template-columns:1fr;gap:42px}}</style>
