---
import BaseLayout from '../layouts/BaseLayout.astro'; import CTASection from '../components/CTASection.astro';
---
<BaseLayout title="O KALTRUCK | Transport HDS Kalwasińscy" description="Transport HDS Kalwasińscy – ponad 10 lat doświadczenia w transporcie specjalistycznym, załadunku, rozładunku i montażu HDS." canonicalPath="/o-nas/">
<section class="page-head section"><div class="container page-head-grid"><div><p class="eyebrow">KALTRUCK / Kalwasińscy</p><h1>Sprzęt jest ważny.<br/>Doświadczenie ważniejsze.</h1></div></div></section>
<section class="section"><div class="container about"><p class="lead big">Od ponad 10 lat realizujemy zlecenia wymagające połączenia transportu z pracą hydraulicznego dźwigu samochodowego.</p><div class="about-copy"><p>Obsługujemy firmy i klientów indywidualnych. Pracujemy przy kontenerach, prefabrykatach, maszynach, konstrukcjach, urządzeniach technicznych i wielu nietypowych ładunkach.</p><p>Główna baza działania to rejon Płocka, ale realizujemy zlecenia na terenie całej Polski.</p></div></div></section><CTASection />
</BaseLayout>
<style>.page-head{padding-top:calc(var(--header-height) + clamp(78px,8vw,122px));padding-bottom:clamp(46px,5vw,70px)}.page-head-grid{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:var(--grid-gap)}.page-head-grid>div{grid-column:1/span 10}.page-head h1{font-size:clamp(3.5rem,7vw,7.2rem);line-height:.9;letter-spacing:-.058em;margin:20px 0 0;max-width:12ch}.about{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:var(--grid-gap);align-items:start}.big{grid-column:1/span 7;font-size:clamp(1.55rem,2.7vw,2.65rem);line-height:1.3;color:var(--text);max-width:25ch}.about-copy{grid-column:9/span 4;color:var(--muted);font-size:1.1rem;line-height:1.75}.about-copy p{margin:0 0 22px}@media(max-width:800px){.page-head-grid,.about{grid-template-columns:1fr;gap:32px}.page-head-grid>div,.big,.about-copy{grid-column:1}.page-head h1{font-size:clamp(3.1rem,12vw,5.2rem)}.big{max-width:none}}</style>
