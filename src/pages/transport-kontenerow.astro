---
import { getEntry, render } from 'astro:content';
import ServiceLayout from '../layouts/ServiceLayout.astro';
const entry = await getEntry('services', 'transport-kontenerow');
if (!entry) throw new Error('Missing service content: transport-kontenerow');
const { Content } = await render(entry);
---
<ServiceLayout {...entry.data} canonicalPath="/transport-kontenerow/"><Content /></ServiceLayout>
