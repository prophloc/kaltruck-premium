---
import BaseLayout from '../layouts/BaseLayout.astro'; import CTASection from '../components/CTASection.astro';
const capabilities=[['do 12 ton','maksymalny udźwig HDS'],['do 14 metrów','maksymalny zasięg ramienia'],['do 3 metrów','szerokość obsługiwanych gabarytów']];
---
<BaseLayout title="Sprzęt HDS i możliwości | KALTRUCK" description="Poznaj zweryfikowane możliwości sprzętu KALTRUCK: HDS o różnych kategoriach udźwigu, zasięg ramienia do 14 m i obsługa ciężkich ładunków." canonicalPath="/sprzet/">
<section class="page-head section"><div class="container"><p class="eyebrow">Sprzęt</p><h1>Parametry mają znaczenie.</h1><p class="lead">Dobór pojazdu zależy od masy ładunku, promienia pracy, dojazdu i miejsca ustawienia. Poniżej podajemy wyłącznie parametry potwierdzone w obecnych materiałach firmy.</p></div></section>
<section class="section"><div class="container specs">{capabilities.map(([value,label])=><div><strong>{value}</strong><span>{label}</span></div>)}</div></section>
<section class="section dark"><div class="container cols"><h2 class="section-title">Różne zadania.<br/>Różny HDS.</h2><div><p class="lead">Flota obejmuje rozwiązania do mniejszych prac precyzyjnych, uniwersalnego transportu materiałów oraz cięższych kontenerów i prefabrykatów.</p><p class="lead">Przed wyceną sprawdzamy, czy parametry konkretnej realizacji mieszczą się w bezpiecznym zakresie pracy.</p></div></div></section><CTASection />
</BaseLayout>
<style>.page-head{padding-top:calc(var(--header-height) + 90px)}.page-head h1{font-size:clamp(4rem,8vw,8.5rem);line-height:.9;letter-spacing:-.055em;margin:18px 0 28px}.specs{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.specs div{padding:46px 30px;border-right:1px solid var(--line)}.specs div:first-child{padding-left:0}.specs div:last-child{border:0}.specs strong,.specs span{display:block}.specs strong{font-size:clamp(2.5rem,5vw,5rem);letter-spacing:-.05em;color:var(--accent)}.specs span{color:var(--muted)}.dark{background:var(--bg-elevated)}.cols{display:grid;grid-template-columns:1fr 1fr;gap:70px}@media(max-width:760px){.specs,.cols{grid-template-columns:1fr}.specs div{border-right:0;border-bottom:1px solid var(--line);padding-left:0}}</style>
