---
import BaseLayout from '../layouts/BaseLayout.astro'; import CTASection from '../components/CTASection.astro';
const capabilities=[['do 12 ton','maksymalny udźwig HDS'],['do 14 metrów','maksymalny zasięg ramienia'],['do 3 metrów','szerokość obsługiwanych gabarytów']];
---
<BaseLayout title="Sprzęt HDS i możliwości | KALTRUCK" description="Poznaj zweryfikowane możliwości sprzętu KALTRUCK: HDS o różnych kategoriach udźwigu, zasięg ramienia do 14 m i obsługa ciężkich ładunków." canonicalPath="/sprzet/">
<section class="page-head section"><div class="container page-head-grid"><div><p class="eyebrow">Sprzęt</p><h1>Parametry mają znaczenie.</h1></div><p class="lead">Dobór pojazdu zależy od masy ładunku, promienia pracy, dojazdu i miejsca ustawienia. Poniżej podajemy wyłącznie parametry potwierdzone w obecnych materiałach firmy.</p></div></section>
<section class="section specs-section"><div class="container specs">{capabilities.map(([value,label])=><div><strong>{value}</strong><span>{label}</span></div>)}</div></section>
<section class="section dark"><div class="container cols"><h2 class="section-title">Różne zadania.<br/>Różny HDS.</h2><div><p class="lead">Flota obejmuje rozwiązania do mniejszych prac precyzyjnych, uniwersalnego transportu materiałów oraz cięższych kontenerów i prefabrykatów.</p><p class="lead">Przed wyceną sprawdzamy, czy parametry konkretnej realizacji mieszczą się w bezpiecznym zakresie pracy.</p></div></div></section><CTASection />
</BaseLayout>
<style>.page-head{padding-top:calc(var(--header-height) + clamp(74px,8vw,118px));padding-bottom:clamp(54px,6vw,80px)}.page-head-grid{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:var(--grid-gap);align-items:end}.page-head-grid>div{grid-column:1/span 8}.page-head-grid>.lead{grid-column:9/span 4;margin:0}.page-head h1{font-size:clamp(3.7rem,7vw,7rem);line-height:.9;letter-spacing:-.055em;margin:18px 0 0;max-width:10ch}.specs-section{padding-top:18px}.specs{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.specs div{padding:clamp(34px,4vw,54px) clamp(22px,3vw,34px);border-right:1px solid var(--line)}.specs div:first-child{padding-left:0}.specs div:last-child{border:0}.specs strong,.specs span{display:block}.specs strong{font-size:clamp(2.35rem,4.5vw,4.8rem);letter-spacing:-.05em;color:var(--accent);line-height:.95}.specs span{color:var(--muted);margin-top:10px;max-width:24ch}.dark{background:var(--bg-elevated)}.cols{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:var(--grid-gap)}.cols>.section-title{grid-column:1/span 6}.cols>div{grid-column:8/span 5}.cols .lead+.lead{margin-top:22px}@media(max-width:800px){.page-head-grid,.cols{grid-template-columns:1fr;gap:28px}.page-head-grid>div,.page-head-grid>.lead,.cols>.section-title,.cols>div{grid-column:1}.specs{grid-template-columns:1fr}.specs div{border-right:0;border-bottom:1px solid var(--line);padding-left:0}.specs div:last-child{border-bottom:0}.page-head h1{font-size:clamp(3.3rem,12vw,5.2rem)}}</style>
