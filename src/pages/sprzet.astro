---
import BaseLayout from '../layouts/BaseLayout.astro';
import ReferenceBanner from '../components/ReferenceBanner.astro';
import ReferenceContactStrip from '../components/ReferenceContactStrip.astro';
const capabilities=[
  ['do 12 ton','maksymalny udźwig HDS'],
  ['do 14 metrów','maksymalny zasięg ramienia'],
  ['do 3 metrów','szerokość obsługiwanych gabarytów']
];
---
<BaseLayout title="Sprzęt HDS i możliwości | KALTRUCK" description="Poznaj zweryfikowane możliwości sprzętu KALTRUCK: HDS o różnych kategoriach udźwigu, zasięg ramienia do 14 m i obsługa ciężkich ładunków." canonicalPath="/sprzet/">
  <ReferenceBanner heading="Sprzęt i możliwości HDS" breadcrumb="SPRZĘT" description="Dobieramy pojazd i żuraw do masy, wymiarów i warunków pracy." />
  <section class="sht-article sht-equipment-page">
    <div class="sht-shell">
      <div class="sht-article-title"><span class="sht-small-accent"></span><h2>Sprzęt dopasowany do zadania</h2></div>
      <div class="sht-article-layout">
        <div class="sht-article-text">
          <p class="sht-article-lead">Parametry HDS mają znaczenie przede wszystkim w odniesieniu do konkretnego ładunku i wymaganego promienia podnoszenia.</p>
          <p>KALTRUCK dysponuje sprzętem o różnych kategoriach udźwigu do realizacji transportów kontenerów, maszyn, prefabrykatów i materiałów budowlanych. Zasięg żurawia i dopuszczalny ciężar podnoszenia zależą od konfiguracji urządzenia i ustawienia pojazdu.</p>
          <p>Przed realizacją ustalamy miejsce podjęcia i odłożenia ładunku, dojazd, możliwość rozstawienia podpór oraz warunki podłoża. Podane parametry są wartościami maksymalnymi — nie oznaczają, że można podnieść maksymalny ciężar przy maksymalnym wysięgu.</p>
          <div class="sht-article-cta"><a href="/wycena/">DOBIERZ HDS DO ŁADUNKU <span aria-hidden="true">›</span></a><a href="/realizacje/">ZOBACZ PRACE W TERENIE <span aria-hidden="true">›</span></a></div>
        </div>
        <aside class="sht-article-aside">
          <img src="https://hdsplock.pl/zdj/realizacje/stacje-transformatorowe-07.jpg" width="1435" height="1080" alt="Żuraw HDS przy ustawianiu ciężkiego elementu" loading="lazy" decoding="async"/>
          <div class="sht-article-aside-note"><span>KALTRUCK / SPRZĘT</span><p>Transport ciężarowy i rozładunek żurawiem.</p></div>
        </aside>
      </div>
      <div class="sht-inner-facts sht-specs">
        {capabilities.map(([value,label])=><div><strong>{value}</strong><span>{label}</span></div>)}
      </div>
    </div>
  </section>
  <ReferenceContactStrip/>
</BaseLayout>