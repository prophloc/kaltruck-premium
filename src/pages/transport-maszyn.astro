---
import { getEntry, render } from 'astro:content';
import ServiceLayout from '../layouts/ServiceLayout.astro';
const entry = await getEntry('services', 'transport-maszyn');
if (!entry) throw new Error('Missing service content: transport-maszyn');
const { Content } = await render(entry);
---
<ServiceLayout {...entry.data} canonicalPath="/transport-maszyn/"><Content /></ServiceLayout>
