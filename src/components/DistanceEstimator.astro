---
import { siteConfig } from '../config/site';

const mapsApiKey = import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY || '';
const baseAddress = siteConfig.baseAddress;
const fallbackMap = `https://www.google.com/maps?q=${encodeURIComponent(baseAddress)}&output=embed`;
const initialMap = mapsApiKey
  ? `https://www.google.com/maps/embed/v1/place?key=${encodeURIComponent(mapsApiKey)}&q=${encodeURIComponent(baseAddress)}&language=pl&region=PL`
  : fallbackMap;
---
<section
  class="google-route"
  data-google-route
  data-base-address={baseAddress}
  data-api-key={mapsApiKey}
>
  <div class="google-route-panel">
    <p class="google-route-label">Google Maps</p>
    <h2>Sprawdź trasę do KALTRUCK</h2>
    <p class="google-route-copy">Wpisz miejscowość lub adres. Trasa, kilometry i przewidywany czas przejazdu pojawią się bezpośrednio na mapie Google.</p>

    <form class="google-route-form" data-google-route-form>
      <label class="sr-only" for="kaltruck-route-origin">Skąd jedziesz?</label>
      <input
        id="kaltruck-route-origin"
        data-google-route-origin
        type="text"
        inputmode="search"
        autocomplete="street-address"
        placeholder="Np. Warszawa, Kutno, Łódź…"
        required
      />
      <button type="submit">Pokaż trasę</button>
    </form>

    <div class="google-route-meta">
      <a href={siteConfig.googleMapsUrl} target="_blank" rel="noreferrer">Baza: {baseAddress}</a>
      <span data-google-route-status>{mapsApiKey ? 'Mapa Google jest gotowa do wyznaczenia trasy.' : 'Do wyznaczania trasy na stronie potrzebny jest klucz Maps Embed API.'}</span>
    </div>
  </div>

  <div class="google-route-map-shell">
    <iframe
      data-google-route-map
      title="Google Maps — trasa do KALTRUCK"
      src={initialMap}
      loading="lazy"
      referrerpolicy="strict-origin-when-cross-origin"
      allowfullscreen
    ></iframe>
  </div>
</section>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-google-route]');
    if (!root) return;

    const form = root.querySelector('[data-google-route-form]');
    const input = root.querySelector('[data-google-route-origin]');
    const iframe = root.querySelector('[data-google-route-map]');
    const status = root.querySelector('[data-google-route-status]');
    const baseAddress = root.getAttribute('data-base-address') || 'Tokarska 40, 09-401 Płock';

    if (!(form instanceof HTMLFormElement) || !(input instanceof HTMLInputElement) || !(iframe instanceof HTMLIFrameElement)) return;

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const origin = input.value.trim();
      if (!origin) return;

      const apiKey = root.getAttribute('data-api-key') || '';
      if (!apiKey) {
        if (status) status.textContent = 'Włącz Maps Embed API i dodaj PUBLIC_GOOGLE_MAPS_API_KEY, aby trasa była widoczna tutaj na stronie.';
        return;
      }

      const params = new URLSearchParams({
        key: apiKey,
        origin,
        destination: baseAddress,
        mode: 'driving',
        units: 'metric',
        language: 'pl',
        region: 'PL',
      });

      iframe.src = `https://www.google.com/maps/embed/v1/directions?${params.toString()}`;
      if (status) status.textContent = `Google Maps: ${origin} → ${baseAddress}`;
    });
  })();
</script>

<style>
  .google-route{display:grid;grid-template-columns:minmax(270px,.72fr) minmax(0,1.28fr);gap:clamp(20px,2.6vw,38px);align-items:stretch;margin:0 0 16px;padding:0 0 16px;border-bottom:1px solid var(--line)}
  .google-route-panel{display:flex;flex-direction:column;justify-content:center;min-width:0}
  .google-route-label{margin:0 0 6px;color:var(--accent);font-size:.66rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase}
  .google-route h2{margin:0 0 8px;color:#f4f1eb;font-size:clamp(1.45rem,2vw,2.05rem);line-height:1;letter-spacing:-.04em}
  .google-route-copy{margin:0 0 14px;color:#98948d;font-size:.82rem;line-height:1.45;max-width:50ch}
  .google-route-form{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px}
  .google-route-form input{min-width:0;height:46px;padding:0 13px;border:1px solid rgba(255,255,255,.15);border-radius:11px;background:#0d0f11;color:#f4f1eb;font:inherit;outline:none}
  .google-route-form input:focus{border-color:rgba(215,180,106,.72);box-shadow:0 0 0 3px rgba(215,180,106,.08)}
  .google-route-form button{height:46px;padding:0 18px;border:1px solid rgba(215,180,106,.56);border-radius:11px;background:var(--accent);color:#090a0b;font:inherit;font-size:.78rem;font-weight:850;cursor:pointer}
  .google-route-form button:hover{filter:brightness(1.06)}
  .google-route-meta{display:grid;gap:3px;margin-top:9px;font-size:.72rem;line-height:1.35}
  .google-route-meta a{width:max-content;max-width:100%;color:#d9ba68;text-decoration:none}
  .google-route-meta span{color:#77736d}
  .google-route-map-shell{min-height:200px;overflow:hidden;border:1px solid rgba(255,255,255,.1);border-radius:16px;background:#0c0e10}
  .google-route-map-shell iframe{display:block;width:100%;height:100%;min-height:200px;border:0;filter:saturate(.82) contrast(1.02)}
  .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
  @media(max-width:900px){.google-route{grid-template-columns:1fr}.google-route-panel{max-width:46rem}.google-route-map-shell,.google-route-map-shell iframe{min-height:280px}}
  @media(max-width:560px){.google-route{gap:16px}.google-route-form{grid-template-columns:1fr}.google-route-form button{width:100%}.google-route-map-shell,.google-route-map-shell iframe{min-height:250px}}
</style>
