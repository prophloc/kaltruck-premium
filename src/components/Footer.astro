---
import { siteConfig } from '../config/site';
import DistanceEstimator from './DistanceEstimator.astro';
---
<footer class="site-footer">
  <div class="container"><DistanceEstimator /></div>
  <div class="container footer-grid">
    <div class="footer-brand">
      <img src="/brand/kaltruck-logo.svg" width="2548" height="1305" alt="KALTRUCK Transport HDS" />
      <p><span>Ciężki ładunek.</span><span>Precyzyjna robota.</span></p>
    </div>
    <div class="footer-links-wrap">
      <p class="footer-label">Nawigacja</p>
      <div class="footer-links">
        <a href="/transport-hds/">Usługi</a><a href="/realizacje/">Realizacje</a><a href="/sprzet/">Sprzęt</a><a href="/o-nas/">O nas</a><a href="/kontakt/">Kontakt</a>
      </div>
    </div>
    <div class="footer-contact">
      <p class="footer-label">Kontakt</p>
      <a class="footer-phone" href={`tel:${siteConfig.phone}`}>+48 514 948 373</a>
      <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
      <a class="footer-address" href={siteConfig.googleMapsUrl} target="_blank" rel="noreferrer">{siteConfig.baseAddress}</a>
    </div>
  </div>
  <div class="container footer-bottom"><span>© {new Date().getFullYear()} {siteConfig.legalName}</span><span>Transport HDS</span></div>
</footer>
<style>
  .site-footer{border-top:1px solid var(--line);background:#060708;padding:clamp(32px,2.7vw,40px) 0 18px}
  .footer-grid{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:var(--grid-gap);align-items:start}
  .footer-brand{grid-column:1/span 4;max-width:24rem}
  .footer-brand img{display:block;width:clamp(195px,13vw,220px);height:auto;filter:invert(1);margin-bottom:10px}
  .footer-brand p{margin:0;color:#bbb7af;font-size:clamp(1.02rem,1.28vw,1.2rem);line-height:1.4;max-width:22ch}
  .footer-brand p span{display:block}
  .footer-links-wrap{grid-column:6/span 2}
  .footer-contact{grid-column:9/-1}
  .footer-label{margin:0 0 10px;color:var(--accent);font-size:.68rem;font-weight:800;letter-spacing:.13em;text-transform:uppercase}
  .footer-links,.footer-contact{display:grid;align-content:start;gap:7px}
  .footer-links a{width:max-content;color:#e7e4de}
  .footer-links a:hover{color:var(--accent)}
  .footer-contact{color:#9d9992}
  .footer-contact a{overflow-wrap:anywhere}
  .footer-address{color:#9d9992;text-decoration:none}
  .footer-address:hover{color:var(--accent)}
  .footer-phone{color:#fff!important;font-size:clamp(1.1rem,1.45vw,1.32rem);font-weight:800;letter-spacing:-.02em}
  .footer-bottom{border-top:1px solid var(--line);margin-top:20px;padding-top:13px;display:flex;justify-content:space-between;gap:20px;color:#777;font-size:.74rem}
  @media(max-width:900px){
    .footer-brand{grid-column:1/span 5}
    .footer-links-wrap{grid-column:7/span 2}
    .footer-contact{grid-column:9/-1}
  }
  @media(max-width:760px){
    .site-footer{padding-top:30px}
    .footer-grid{grid-template-columns:1fr 1fr;gap:28px 22px}
    .footer-brand{grid-column:1/-1}
    .footer-links-wrap,.footer-contact{grid-column:auto}
    .footer-brand img{width:clamp(190px,45vw,220px)}
    .footer-bottom{margin-top:24px;flex-direction:column;gap:7px}
  }
</style>
