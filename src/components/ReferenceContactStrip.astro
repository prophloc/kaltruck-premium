---
import { siteConfig } from '../config/site';
interface Props { title?:string; }
const { title='SKONTAKTUJ SIĘ Z NAMI' }=Astro.props;
---
<section class="sht-contact" aria-labelledby="sht-contact-title">
  <div class="sht-shell">
    <h2 id="sht-contact-title">{title}</h2>
    <div class="sht-contact-grid">
      <div class="sht-contact-item">
        <span class="sht-contact-icon" aria-hidden="true">☎</span>
        <div><h3>Telefon</h3><p>Porozmawiajmy o transporcie</p><a href={`tel:${siteConfig.phone}`}>+48 784 430 022</a></div>
      </div>
      <div class="sht-contact-item">
        <span class="sht-contact-icon" aria-hidden="true">✉</span>
        <div><h3>Zapytania i wyceny</h3><p>Prześlij dane ładunku i trasy</p><a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a></div>
      </div>
      <div class="sht-contact-item">
        <span class="sht-contact-icon" aria-hidden="true">⌖</span>
        <div><h3>Baza transportowa</h3><p>Płock, Polska</p><a href={siteConfig.googleMapsUrl} target="_blank" rel="noopener noreferrer">{siteConfig.baseAddress}</a></div>
      </div>
    </div>
    <div class="sht-contact-bottom">
      <span>Potrzebujesz transportu HDS?</span>
      <a href="/wycena/">PRZEJDŹ DO FORMULARZA WYCENY <span aria-hidden="true">›</span></a>
    </div>
  </div>
</section>