---
interface Props { eyebrow:string; title:string; text:string; href:string; image:string; alt:string; reverse?:boolean; width?:number; height?:number; }
const { eyebrow,title,text,href,image,alt,reverse=false,width=1440,height=1080 }=Astro.props;
---
<section class:list={['story', reverse && 'reverse']}>
  <div class="container story-inner">
    <div class="story-media"><img src={image} alt={alt} width={width} height={height} loading="lazy" /></div>
    <div class="story-copy">
      <p class="eyebrow">{eyebrow}</p>
      <h2>{title}</h2>
      <p>{text}</p>
      <a href={href}>Zobacz usługę <span>↗</span></a>
    </div>
  </div>
</section>
<style>
  .story{border-bottom:1px solid var(--line);background:#0a0b0c}
  .story:nth-of-type(even){background:#0c0e10}
  .story-inner{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:var(--grid-gap);align-items:center;padding-block:clamp(58px,6vw,92px)}
  .story-media{grid-column:1 / span 7;aspect-ratio:1.22 / 1;min-height:0;overflow:hidden;border-radius:2px;background:#111315}
  .story-copy{grid-column:8 / -1;max-width:36rem;padding-left:clamp(10px,2.6vw,42px)}
  .story.reverse .story-media{grid-column:6 / -1;order:2}
  .story.reverse .story-copy{grid-column:1 / span 5;order:1;padding-left:0;padding-right:clamp(10px,2.6vw,42px)}
  .story-media img{width:100%;height:100%;object-fit:cover;transition:transform .7s ease}
  .story:hover .story-media img{transform:scale(1.018)}
  .story-copy h2{font-size:clamp(2.35rem,4vw,4.9rem);line-height:.96;letter-spacing:-.05em;margin:18px 0 24px;text-wrap:balance}
  .story-copy p:not(.eyebrow){color:var(--muted);font-size:clamp(1rem,1.2vw,1.12rem);max-width:42ch;margin:0}
  .story-copy a{display:inline-flex;align-items:center;gap:10px;margin-top:30px;font-weight:760;color:var(--accent)}
  .story-copy a span{transition:transform .2s ease}
  .story-copy a:hover span{transform:translate(2px,-2px)}
  @media(max-width:980px){
    .story-inner{grid-template-columns:repeat(12,minmax(0,1fr));padding-block:56px}
    .story-media{grid-column:1 / span 7}
    .story-copy{grid-column:8 / -1;padding-left:12px}
    .story.reverse .story-copy{grid-column:1 / span 5;padding-right:12px}
    .story.reverse .story-media{grid-column:6 / -1}
  }
  @media(max-width:780px){
    .story-inner{grid-template-columns:1fr;gap:32px;padding-block:38px}
    .story-media,.story-copy,.story.reverse .story-media,.story.reverse .story-copy{grid-column:auto;order:initial;padding:0}
    .story.reverse .story-media{order:initial}
    .story-media{aspect-ratio:4 / 3}
    .story-copy{max-width:100%;padding-bottom:8px}
    .story-copy h2{font-size:clamp(2.2rem,10vw,3.8rem)}
  }
</style>
