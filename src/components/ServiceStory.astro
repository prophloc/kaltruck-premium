---
interface Props { eyebrow:string; title:string; text:string; href:string; image:string; alt:string; reverse?:boolean; width?:number; height?:number; }
const { eyebrow,title,text,href,image,alt,reverse=false,width=1440,height=1080 }=Astro.props;
---
<section class:list={['story', reverse && 'reverse']}>
  <div class="story-media"><img src={image} alt={alt} width={width} height={height} loading="lazy" /></div>
  <div class="story-copy"><p class="eyebrow">{eyebrow}</p><h2>{title}</h2><p>{text}</p><a href={href}>Zobacz usługę <span>↗</span></a></div>
</section>
<style>.story{display:grid;grid-template-columns:1.15fr .85fr;min-height:720px;border-bottom:1px solid var(--line)}.story.reverse{grid-template-columns:.85fr 1.15fr}.story.reverse .story-media{order:2}.story-media{min-height:520px;overflow:hidden}.story-media img{width:100%;height:100%;object-fit:cover;transition:transform .7s ease}.story:hover .story-media img{transform:scale(1.025)}.story-copy{padding:clamp(48px,8vw,110px);display:flex;flex-direction:column;justify-content:center}.story-copy h2{font-size:clamp(2.8rem,5vw,6rem);line-height:.92;letter-spacing:-.05em;margin:18px 0 26px}.story-copy p:not(.eyebrow){color:var(--muted);font-size:1.08rem;max-width:46ch}.story-copy a{margin-top:28px;font-weight:760;color:var(--accent)}@media(max-width:820px){.story,.story.reverse{grid-template-columns:1fr;min-height:0}.story.reverse .story-media{order:0}.story-media{min-height:60vw}.story-copy{padding:54px 24px}}</style>
