---
interface Project { data: { title:string; category:string; image:string; alt:string; width:number; height:number; summary?:string } }
const { projects } = Astro.props as { projects: Project[] };
---
<div class="project-gallery" data-project-gallery>
  {projects.map((project, index) => (
    <article class:list={['project', index % 2 === 0 ? 'project--feature' : 'project--support']}>
      <div class="project-media">
        <img src={project.data.image} alt={project.data.alt} width={project.data.width} height={project.data.height} loading={index < 2 ? 'eager' : 'lazy'} />
      </div>
      <div class="project-meta"><span>{project.data.category}</span><h2>{project.data.title}</h2></div>
    </article>
  ))}
</div>
<style>
.project-gallery{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:clamp(18px,2vw,28px);align-items:start}.project{margin:0 0 clamp(24px,3vw,42px)}.project--feature{grid-column:span 7}.project--support{grid-column:span 5}.project-media{overflow:hidden;background:#151719;border-radius:var(--radius-md);aspect-ratio:4/3}.project-media img{width:100%;height:100%;object-fit:cover;transition:transform .5s ease}.project:hover img{transform:scale(1.02)}.project-meta{display:grid;gap:8px;padding-top:16px}.project-meta span{color:var(--accent);font-size:.72rem;text-transform:uppercase;letter-spacing:.14em}.project-meta h2{font-size:clamp(1.35rem,2vw,2.2rem);line-height:1.05;letter-spacing:-.03em;margin:0;max-width:18ch}@media(max-width:760px){.project-gallery{grid-template-columns:1fr}.project--feature,.project--support{grid-column:1}.project{margin-bottom:34px}.project-meta h2{font-size:1.6rem}}
</style>
