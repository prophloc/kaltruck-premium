---
import { siteConfig } from '../config/site';
---
<section class="hero">
  <img class="hero-bg" src="https://hdsplock.pl/zdj/realizacje/transport-kontenerow-07.jpg" width="1440" height="1080" alt="Samochód KALTRUCK z żurawiem HDS podczas realizacji transportowej" fetchpriority="high" />
  <div class="hero-overlay"></div>
  <div class="container hero-content">
    <p class="eyebrow">Transport HDS • Płock • Polska</p>
    <h1>TRANSPORT, KTÓRY<br /><span>PODNOSI WIĘCEJ.</span></h1>
    <p class="hero-lead">Transport HDS, załadunek, rozładunek i montaż. Od kontenerów po prefabrykaty, maszyny i ładunki specjalistyczne.</p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="/wycena/">Wyceń transport</a>
      <a class="btn btn-secondary" href={`tel:${siteConfig.phone}`}>Zadzwoń: 514 948 373</a>
    </div>
  </div>
  <div class="hero-scroll">PRZEWIŃ <span>↓</span></div>
</section>
<style>
.hero{min-height:100svh;position:relative;display:flex;align-items:flex-end;overflow:hidden}.hero-bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 55%}.hero-overlay{position:absolute;inset:0;background:linear-gradient(180deg,rgba(5,6,7,.18),rgba(5,6,7,.45) 48%,rgba(5,6,7,.94)),linear-gradient(90deg,rgba(5,6,7,.72),transparent 66%)}.hero-content{position:relative;z-index:2;padding-bottom:clamp(78px,9vw,130px);padding-top:140px}.hero h1{font-size:clamp(3.7rem,9.5vw,9.6rem);line-height:.84;letter-spacing:-.065em;margin:18px 0 28px;max-width:11ch}.hero h1 span{color:var(--accent)}.hero-lead{font-size:clamp(1.05rem,1.7vw,1.45rem);max-width:52ch;color:#ddd9d0}.hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:32px}.hero-scroll{position:absolute;z-index:2;right:32px;bottom:34px;font-size:.68rem;letter-spacing:.18em;color:#b9b7b0;writing-mode:vertical-rl}.hero-scroll span{font-size:1rem;margin-top:10px}@media(max-width:650px){.hero-scroll{display:none}.hero h1{font-size:clamp(3.2rem,17vw,5.2rem)}}
</style>
