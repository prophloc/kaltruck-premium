---
import { siteConfig } from '../config/site';
---
<section class="hero">
  <img class="hero-bg" src="https://hdsplock.pl/zdj/realizacje/transport-kontenerow-07.jpg" width="1440" height="1080" alt="Samochód KALTRUCK z żurawiem HDS podczas realizacji transportowej" fetchpriority="high" />
  <div class="hero-overlay"></div>
  <div class="container hero-content">
    <p class="eyebrow">Transport HDS • Płock • Polska</p>
    <h1>TRANSPORT, KTÓRY<br /><span>PODNOSI WIĘCEJ.</span></h1>
    <p class="hero-lead">Transport HDS, załadunek, rozładunek i montaż. Od kontenerów po prefabrykaty, maszyny i ładunki specjalistyczne.</p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="/wycena/">Wyceń transport</a>
      <a class="btn btn-secondary" href={`tel:${siteConfig.phone}`}>Zadzwoń: 514 948 373</a>
    </div>
  </div>
  <div class="hero-scroll">PRZEWIŃ <span>↓</span></div>
</section>
<style>
.hero{min-height:100svh;position:relative;display:flex;align-items:flex-end;overflow:hidden;border-bottom:1px solid rgba(255,255,255,.06)}
.hero-bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 52%}
.hero-overlay{position:absolute;inset:0;background:linear-gradient(180deg,rgba(5,6,7,.12),rgba(5,6,7,.34) 42%,rgba(5,6,7,.92) 100%),linear-gradient(90deg,rgba(5,6,7,.75) 0%,rgba(5,6,7,.46) 42%,rgba(5,6,7,.08) 72%)}
.hero-content{position:relative;z-index:2;padding-top:calc(var(--header-height) + clamp(70px,8vh,120px));padding-bottom:clamp(66px,8vh,108px)}
.hero h1{font-size:clamp(4rem,8.15vw,8.8rem);line-height:.86;letter-spacing:-.062em;margin:18px 0 26px;max-width:9.8ch;text-wrap:balance}
.hero h1 span{color:var(--accent)}
.hero-lead{font-size:clamp(1.05rem,1.4vw,1.35rem);line-height:1.55;max-width:50ch;margin:0;color:#ddd9d0}
.hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:30px}
.hero-scroll{position:absolute;z-index:2;right:max(var(--page-gutter),24px);bottom:34px;font-size:.68rem;letter-spacing:.18em;color:#b9b7b0;writing-mode:vertical-rl}
.hero-scroll span{font-size:1rem;margin-top:10px}
@media(max-width:1180px){.hero h1{font-size:clamp(4rem,8.7vw,7.3rem);max-width:10.2ch}.hero-bg{object-position:58% 52%}}
@media(max-width:760px){.hero{min-height:92svh}.hero-content{padding-top:calc(var(--header-height) + 70px);padding-bottom:58px}.hero h1{font-size:clamp(3rem,14.5vw,5rem);line-height:.88;max-width:9.5ch;margin-bottom:22px}.hero-lead{font-size:1.04rem;max-width:38ch}.hero-actions{margin-top:26px}.hero-actions .btn{width:100%}.hero-scroll{display:none}.hero-bg{object-position:62% center}.hero-overlay{background:linear-gradient(180deg,rgba(5,6,7,.2),rgba(5,6,7,.42) 38%,rgba(5,6,7,.96) 100%),linear-gradient(90deg,rgba(5,6,7,.72),rgba(5,6,7,.12) 88%)}}
</style>
