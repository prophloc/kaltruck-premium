---
import { siteConfig } from '../config/site';
import DistanceEstimator from './DistanceEstimator.astro';
import GoogleMapsPin from './GoogleMapsPin.astro';
import GoogleReviews from './GoogleReviews.astro';
---
<section class="hero" data-commercial-hero>
  <picture class="hero-picture">
    <source media="(max-width: 620px)" srcset="/images/home/hero-hds-mobile.webp" type="image/webp" />
    <img class="hero-bg" src="/images/home/hero-hds-desktop.webp" width="1672" height="941" alt="Czerwony samochód HDS KALTRUCK z żurawiem podnoszącym kontener" fetchpriority="high" loading="eager" decoding="async" />
  </picture>
  <div class="hero-overlay"></div>

  <div class="hero-route-drawer" data-hero-route-drawer>
    <div id="hero-route-panel" class="hero-route-panel" data-hero-route-panel aria-hidden="true">
      <DistanceEstimator instanceId="hero-route" variant="drawer" deferMap={true} />
    </div>
    <button
      class="hero-route-toggle"
      type="button"
      data-hero-route-toggle
      aria-expanded="false"
      aria-controls="hero-route-panel"
      aria-label="Sprawdź trasę transportu"
    >
      <GoogleMapsPin class="hero-route-toggle-pin" />
      <span class="hero-route-toggle-label" data-route-handle-label>TRASA</span>
    </button>
  </div>

  <div class="hero-reviews-drawer" data-hero-reviews-drawer>
    <button
      class="hero-reviews-toggle"
      type="button"
      data-hero-reviews-toggle
      aria-expanded="false"
      aria-controls="hero-reviews-panel"
      aria-label="Pokaż opinie klientów Google"
    >
      <span class="hero-reviews-toggle-star" data-reviews-handle-star aria-hidden="true">★</span>
      <span class="hero-reviews-toggle-label">OPINIE</span>
    </button>
    <div id="hero-reviews-panel" class="hero-reviews-panel" data-hero-reviews-panel aria-hidden="true">
      <GoogleReviews />
    </div>
  </div>

  <div class="container hero-content">
    <div class="hero-stage">
      <div class="hero-lockup">
        <h1 class="hero-title" aria-label="Ciężki ładunek? Zostaw to nam!">
          <span class="hero-title-line hero-title-line--one">CIĘŻKI ŁADUNEK?</span>
          <span class="hero-title-line hero-title-line--two">ZOSTAW TO NAM!</span>
        </h1>

        <div class="hero-support">
          <div class="hero-actions">
            <a class="btn btn-primary" href="/wycena/">Wyceń transport</a>
            <a class="btn btn-secondary hero-phone" href={`tel:${siteConfig.phone}`}>Zadzwoń: 784 430 022</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="hero-bottom-copy">
    <div class="hero-bottom-copy-inner">
      <p class="hero-lead">Transport HDS, załadunek, rozładunek i montaż. Od kontenerów po prefabrykaty, maszyny i ładunki specjalistyczne.</p>
    </div>
  </div>

  <div class="hero-scroll">PRZEWIŃ <span>↓</span></div>
</section>

<script is:inline>
  (() => {
    const routeDrawer = document.querySelector('[data-hero-route-drawer]');
    const routeToggle = routeDrawer?.querySelector('[data-hero-route-toggle]');
    const routePanel = routeDrawer?.querySelector('[data-hero-route-panel]');
    const route = routeDrawer?.querySelector('[data-google-route]');
    const routeInput = routeDrawer?.querySelector('[data-google-route-origin]');

    const reviewsDrawer = document.querySelector('[data-hero-reviews-drawer]');
    const reviewsToggle = reviewsDrawer?.querySelector('[data-hero-reviews-toggle]');
    const reviewsPanel = reviewsDrawer?.querySelector('[data-hero-reviews-panel]');
    const reviews = reviewsDrawer?.querySelector('[data-google-reviews]');

    if (
      !(routeDrawer instanceof HTMLElement) ||
      !(routeToggle instanceof HTMLButtonElement) ||
      !(routePanel instanceof HTMLElement) ||
      !(reviewsDrawer instanceof HTMLElement) ||
      !(reviewsToggle instanceof HTMLButtonElement) ||
      !(reviewsPanel instanceof HTMLElement)
    ) return;

    const setRouteOpen = (open) => {
      routeDrawer.classList.toggle('is-open', open);
      routeToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      routePanel.setAttribute('aria-hidden', open ? 'false' : 'true');

      if (open) {
        setReviewsOpen(false);
        if (route instanceof HTMLElement) route.dispatchEvent(new CustomEvent('kaltruck:route-activate'));
        window.setTimeout(() => {
          if (routeInput instanceof HTMLInputElement) routeInput.focus({ preventScroll: true });
        }, 320);
      }
    };

    const setReviewsOpen = (open) => {
      reviewsDrawer.classList.toggle('is-open', open);
      reviewsToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      reviewsPanel.setAttribute('aria-hidden', open ? 'false' : 'true');

      if (open) {
        if (routeToggle.getAttribute('aria-expanded') === 'true') {
          routeDrawer.classList.remove('is-open');
          routeToggle.setAttribute('aria-expanded', 'false');
          routePanel.setAttribute('aria-hidden', 'true');
        }
        if (reviews instanceof HTMLElement) reviews.dispatchEvent(new CustomEvent('kaltruck:reviews-activate'));
      }
    };

    routeToggle.addEventListener('click', () => {
      setRouteOpen(routeToggle.getAttribute('aria-expanded') !== 'true');
    });

    reviewsToggle.addEventListener('click', () => {
      setReviewsOpen(reviewsToggle.getAttribute('aria-expanded') !== 'true');
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      setRouteOpen(false);
      setReviewsOpen(false);
    });

    document.addEventListener('pointerdown', (event) => {
      if (!(event.target instanceof Node)) return;
      if (routeToggle.getAttribute('aria-expanded') === 'true' && !routeDrawer.contains(event.target)) setRouteOpen(false);
      if (reviewsToggle.getAttribute('aria-expanded') === 'true' && !reviewsDrawer.contains(event.target)) setReviewsOpen(false);
    });
  })();
</script>

<style>
.hero{
  min-height:100svh;
  position:relative;
  display:grid;
  overflow:hidden;
  border-bottom:1px solid rgba(255,255,255,.06);
}
.hero-picture{position:absolute;inset:0;display:block;width:100%;height:100%}
.hero-bg{
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
  object-fit:cover;
  object-position:center 50%;
}
.hero-overlay{
  position:absolute;
  inset:0;
  background:
    linear-gradient(180deg,rgba(5,6,7,.2) 0%,rgba(5,6,7,.16) 24%,rgba(5,6,7,.48) 68%,rgba(5,6,7,.94) 100%),
    radial-gradient(circle at 50% 50%,rgba(5,6,7,.08) 0%,rgba(5,6,7,.24) 52%,rgba(5,6,7,.5) 100%);
}
.hero-route-drawer,
.hero-reviews-drawer{
  --hero-drawer-handle:62px;
  position:absolute;
  z-index:7;
  top:50%;
  width:min(760px,calc(100vw - 28px));
  align-items:center;
  transition:transform .34s cubic-bezier(.22,.78,.18,1);
  filter:drop-shadow(18px 24px 42px rgba(0,0,0,.38));
}
.hero-route-drawer{
  left:0;
  display:grid;
  grid-template-columns:minmax(0,1fr) var(--hero-drawer-handle);
  transform:translate(calc(-100% + var(--hero-drawer-handle)),-50%);
}
.hero-route-drawer.is-open{transform:translate(0,-50%)}
.hero-reviews-drawer{
  right:0;
  display:grid;
  grid-template-columns:var(--hero-drawer-handle) minmax(0,1fr);
  width:min(700px,calc(100vw - 28px));
  transform:translate(calc(100% - var(--hero-drawer-handle)),-50%);
}
.hero-reviews-drawer.is-open{transform:translate(0,-50%)}
.hero-route-panel,
.hero-reviews-panel{
  max-height:min(78svh,680px);
  overflow:auto;
  visibility:hidden;
  opacity:0;
  pointer-events:none;
  border:1px solid rgba(20,20,18,.12);
  background:#f7f4ee;
  transition:opacity .2s ease,visibility 0s linear .34s;
}
.hero-route-panel{border-left:0;border-radius:0 18px 18px 0}
.hero-reviews-panel{border-right:0;border-radius:18px 0 0 18px}
.hero-route-drawer.is-open .hero-route-panel,
.hero-reviews-drawer.is-open .hero-reviews-panel{
  visibility:visible;
  opacity:1;
  pointer-events:auto;
  transition:opacity .22s ease .08s,visibility 0s linear 0s;
}
.hero-route-toggle,
.hero-reviews-toggle{
  width:var(--hero-drawer-handle);
  height:clamp(92px,11svh,116px);
  padding:9px 7px;
  border:1px solid rgba(215,180,106,.72);
  background:rgba(248,245,239,.97);
  color:#151514;
  display:flex;
  align-items:center;
  justify-content:center;
  cursor:pointer;
  pointer-events:auto;
  backdrop-filter:blur(12px);
}
.hero-route-toggle{flex-direction:column;gap:8px;border-left:0;border-radius:0 12px 12px 0}
.hero-reviews-toggle{border-right:0;border-radius:12px 0 0 12px;flex-direction:column;gap:8px}
.hero-reviews-toggle-star{display:block;font-size:24px;line-height:1;color:#8e784d;transition:color .2s ease,transform .2s ease}
.hero-reviews-drawer.is-open .hero-reviews-toggle-star,
.hero-reviews-toggle[aria-expanded="true"] .hero-reviews-toggle-star{color:var(--accent);transform:scale(1.12)}
.hero-route-toggle:hover,.hero-reviews-toggle:hover{background:#fff}
.hero-route-toggle-pin{display:block;width:25px;height:25px;object-fit:contain;transform:rotate(-90deg);filter:drop-shadow(0 2px 4px rgba(0,0,0,.16))}
.hero-route-toggle-label,.hero-reviews-toggle-label{writing-mode:vertical-rl;transform:rotate(180deg);font-size:.68rem;font-weight:900;letter-spacing:.16em;line-height:1}
.hero-reviews-toggle-label{font-size:.72rem;letter-spacing:.18em}
.hero-content{
  position:relative;
  z-index:2;
  min-height:100svh;
  display:flex;
  align-items:center;
  justify-content:center;
  padding-top:calc(var(--header-height) + clamp(34px,4.5vh,54px));
  padding-bottom:clamp(146px,16vh,178px);
}
.hero-stage{
  width:min(100%,1180px);
  margin-inline:auto;
  display:grid;
  grid-template-columns:repeat(12,minmax(0,1fr));
  column-gap:var(--grid-gap);
  align-content:center;
}
.hero-lockup{display:contents}
.hero-title{
  grid-column:1 / -1;
  display:grid;
  grid-template-columns:repeat(12,minmax(0,1fr));
  column-gap:var(--grid-gap);
  width:100%;
  margin:0;
  text-transform:uppercase;
}
.hero-title-line{
  display:block;
  width:max-content;
  max-width:100%;
  white-space:nowrap;
  text-shadow:0 18px 55px rgba(0,0,0,.34);
}
.hero-title-line--one{
  grid-column:2 / span 9;
  font-size:clamp(3.7rem,5.8vw,6.4rem);
  line-height:.9;
  letter-spacing:-.052em;
}
.hero-title-line--two{
  grid-column:4 / span 8;
  margin-top:clamp(10px,1.3vh,16px);
  font-size:clamp(4.8rem,7.9vw,8.7rem);
  line-height:.83;
  letter-spacing:-.058em;
  color:var(--accent);
}
.hero-support{
  grid-column:1 / -1;
  display:grid;
  grid-template-columns:repeat(12,minmax(0,1fr));
  column-gap:var(--grid-gap);
  align-items:center;
  margin-top:clamp(28px,3.8vh,42px);
}
.hero-actions{
  grid-column:7 / span 5;
  display:flex;
  justify-content:flex-start;
  align-items:center;
  gap:14px;
  flex-wrap:wrap;
}
.hero-actions .btn{
  min-height:62px;
  padding-inline:30px;
  font-size:1rem;
  font-weight:800;
  box-shadow:0 14px 36px rgba(0,0,0,.2);
}
.hero-phone{
  min-width:240px;
  border-color:rgba(255,255,255,.34);
  background:rgba(0,0,0,.42);
  color:#fff;
}
.hero-bottom-copy{
  position:absolute;
  z-index:3;
  left:0;
  right:0;
  bottom:0;
  width:100%;
  min-height:118px;
  display:flex;
  align-items:center;
  border-top:1px solid rgba(255,255,255,.10);
  background:linear-gradient(180deg,rgba(6,7,8,.08) 0%,rgba(6,7,8,.58) 48%,rgba(6,7,8,.78) 100%);
}
.hero-bottom-copy-inner{
  width:100%;
  padding:26px clamp(40px,3.35vw,64px) 30px;
}
.hero-lead{
  width:100%;
  max-width:none;
  margin:0;
  text-align:center;
  font-size:clamp(1.04rem,1.2vw,1.22rem);
  line-height:1.55;
  color:#f0eee8;
  text-shadow:0 3px 18px rgba(0,0,0,.58);
  text-wrap:balance;
}
.hero-scroll{
  position:absolute;
  z-index:4;
  right:max(var(--page-gutter),24px);
  bottom:132px;
  font-size:.68rem;
  letter-spacing:.18em;
  color:#d0cec7;
  writing-mode:vertical-rl;
}
.hero-scroll span{font-size:1rem;margin-top:10px}

@media(min-width:1181px){
  .hero-lockup{
    grid-column:2 / span 9;
    display:flex;
    width:max-content;
    max-width:100%;
    flex-direction:column;
    align-items:stretch;
    transform:translate(86px,54px);
  }
  .hero-title{
    display:flex;
    width:max-content;
    max-width:100%;
    flex-direction:column;
    align-items:flex-end;
  }
  .hero-title-line--one{transform:none}
  .hero-title-line--two{
    margin-top:2px;
    font-size:clamp(3.05rem,calc(4.1vw - 5px),3.95rem);
    line-height:.9;
    letter-spacing:-.045em;
    transform:translate(-5px,-4px);
  }
  .hero-support{display:block;width:100%;margin-top:clamp(24px,3vh,32px)}
  .hero-actions{display:flex;width:max-content;max-width:100%;margin-inline:auto;justify-content:center;transform:none}
}

@media(max-width:1180px){
  .hero-bg{object-position:58% 50%}
  .hero-stage{width:min(100%,980px)}
  .hero-title-line--one{grid-column:1 / span 10;font-size:clamp(3.2rem,6.4vw,5.4rem)}
  .hero-title-line--two{grid-column:3 / -1;font-size:clamp(4.5rem,9.4vw,7.8rem)}
  .hero-actions{grid-column:6 / -1}
}

@media(max-width:900px){
  .hero{min-height:100svh}
  .hero-route-drawer{width:min(690px,calc(100vw - 18px))}
  .hero-reviews-drawer{width:min(650px,calc(100vw - 18px))}
  .hero-content{min-height:100svh;padding-top:calc(var(--header-height) + 42px);padding-bottom:154px}
  .hero-stage{width:min(100%,780px)}
  .hero-title-line--one{grid-column:1 / -1;font-size:clamp(3rem,8.2vw,4.8rem)}
  .hero-title-line--two{grid-column:2 / -1;font-size:clamp(4.2rem,12.8vw,6.8rem)}
  .hero-support{margin-top:30px}
  .hero-actions{grid-column:1 / span 10;display:flex;justify-content:flex-start}
  .hero-bottom-copy{min-height:112px}
  .hero-bottom-copy-inner{padding:22px var(--page-gutter) 24px}
  .hero-lead{font-size:1.02rem}
  .hero-scroll{display:none}
}

@media(max-width:620px){
  .hero-route-drawer,.hero-reviews-drawer{--hero-drawer-handle:50px;width:calc(100vw - 10px)}
  .hero-route-panel{max-height:76svh;border-radius:0 14px 14px 0}
  .hero-reviews-panel{max-height:76svh;border-radius:14px 0 0 14px}
  .hero-route-toggle{border-radius:0 10px 10px 0;height:clamp(88px,11svh,102px);padding:8px 6px;gap:6px}
  .hero-reviews-toggle{border-radius:10px 0 0 10px;height:clamp(88px,11svh,102px);padding:8px 6px;gap:5px}
  .hero-reviews-toggle-star{font-size:19px}
  .hero-route-toggle-pin{width:22px;height:22px}
  .hero-route-toggle-label,.hero-reviews-toggle-label{font-size:.61rem;letter-spacing:.13em}
  .hero-bg{object-position:64% center}
  .hero-overlay{
    background:
      linear-gradient(180deg,rgba(5,6,7,.28) 0%,rgba(5,6,7,.28) 34%,rgba(5,6,7,.78) 72%,rgba(5,6,7,.97) 100%),
      radial-gradient(circle at 50% 50%,rgba(5,6,7,.18),rgba(5,6,7,.5) 100%);
  }
  .hero-content{padding-top:calc(var(--header-height) + 34px);padding-bottom:176px}
  .hero-stage{display:block;width:100%}
  .hero-title{display:block}
  .hero-title-line{white-space:normal;width:auto}
  .hero-title-line--one{font-size:clamp(2.7rem,12.6vw,3.7rem);line-height:.92}
  .hero-title-line--two{margin-top:9px;margin-left:clamp(18px,6vw,34px);font-size:clamp(3.5rem,15.5vw,4.8rem);line-height:.84}
  .hero-support{display:block;margin-top:24px}
  .hero-actions{display:grid;gap:10px}
  .hero-actions .btn{width:100%;min-height:58px;font-size:.98rem}
  .hero-bottom-copy{min-height:142px}
  .hero-bottom-copy-inner{padding:21px var(--page-gutter) 24px}
  .hero-lead{text-align:left;max-width:34ch;font-size:.98rem;line-height:1.5}
}

/* Compact mobile hero controls: side by side below the header, not over the CTA. */
@media(max-width:620px){
  .hero{
    min-height:max(100svh,680px);
  }
  .hero-route-drawer,
  .hero-reviews-drawer{
    top:calc(var(--header-height) + 12px);
    --hero-drawer-handle:auto;
    z-index:8;
    display:flex;
    flex-direction:column;
    width:max-content;
    max-width:calc(50vw - var(--page-gutter) - 6px);
    transform:none;
    filter:drop-shadow(0 6px 15px rgba(0,0,0,.24));
    transition:none;
  }
  .hero-route-drawer{left:var(--page-gutter)}
  .hero-reviews-drawer{right:var(--page-gutter)}
  .hero-route-drawer.is-open,
  .hero-reviews-drawer.is-open{transform:none}
  .hero-route-toggle,
  .hero-reviews-toggle{
    width:auto;
    max-width:100%;
    height:44px;
    min-height:44px;
    padding:8px 12px;
    gap:8px;
    flex-direction:row;
    border:1px solid rgba(215,180,106,.72);
    border-radius:999px;
    box-shadow:0 6px 18px rgba(0,0,0,.24);
  }
  .hero-route-toggle-pin{width:18px;height:18px}
  .hero-reviews-toggle-star{font-size:17px}
  .hero-route-toggle-label,
  .hero-reviews-toggle-label{
    writing-mode:horizontal-tb;
    transform:none;
    font-size:.68rem;
    line-height:1;
    letter-spacing:.1em;
  }
  .hero-route-panel,
  .hero-reviews-panel{
    position:absolute;
    top:calc(100% + 10px);
    width:min(440px,calc(100vw - 2 * var(--page-gutter)));
    max-height:min(60svh,520px);
    overflow:auto;
    border:1px solid rgba(20,20,18,.12);
    border-radius:16px;
    box-shadow:0 20px 54px rgba(0,0,0,.48);
  }
  .hero-route-panel{left:0}
  .hero-reviews-panel{right:0}
  .hero-content{
    min-height:max(100svh,680px);
    padding-top:calc(var(--header-height) + 95px);
    padding-bottom:158px;
  }
  .hero-actions{
    display:grid;
    width:100%;
    grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);
    gap:8px;
    align-items:stretch;
  }
  .hero-actions .btn{
    width:100%;
    min-width:0;
    min-height:54px;
    padding-inline:6px;
    font-size:clamp(.72rem,2.8vw,.9rem);
    line-height:1.18;
    white-space:nowrap;
  }
  .hero-phone{min-width:0}
}
</style>
