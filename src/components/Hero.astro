---
import { siteConfig } from '../config/site';
---
<section class="hero" data-commercial-hero>
  <img class="hero-bg" src="https://hdsplock.pl/zdj/realizacje/transport-kontenerow-07.jpg" width="1440" height="1080" alt="Samochód KALTRUCK z żurawiem HDS podczas realizacji transportowej" fetchpriority="high" />
  <div class="hero-overlay"></div>

  <div class="container hero-content">
    <div class="hero-stage">
      <p class="eyebrow hero-kicker">Transport HDS • Płock • Polska</p>

      <h1 class="hero-title" aria-label="Transport, który podnosi więcej.">
        <span class="hero-title-line hero-title-line--one">TRANSPORT, KTÓRY</span>
        <span class="hero-title-line hero-title-line--two">PODNOSI</span>
        <span class="hero-title-line hero-title-line--three">WIĘCEJ.</span>
      </h1>

      <div class="hero-support">
        <div class="hero-actions">
          <a class="btn btn-primary" href="/wycena/">Wyceń transport</a>
          <a class="btn btn-secondary hero-phone" href={`tel:${siteConfig.phone}`}>Zadzwoń: 514 948 373</a>
        </div>
      </div>
    </div>
  </div>

  <div class="hero-bottom-copy">
    <div class="hero-bottom-copy-inner">
      <p class="hero-lead">Transport HDS, załadunek, rozładunek i montaż. Od kontenerów po prefabrykaty, maszyny i ładunki specjalistyczne.</p>
    </div>
  </div>

  <div class="hero-scroll">PRZEWIŃ <span>↓</span></div>
</section>

<style>
.hero{
  min-height:100svh;
  position:relative;
  display:grid;
  overflow:hidden;
  border-bottom:1px solid rgba(255,255,255,.06);
}
.hero-bg{
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
  object-fit:cover;
  object-position:center 50%;
}
.hero-overlay{
  position:absolute;
  inset:0;
  background:
    linear-gradient(180deg,rgba(5,6,7,.2) 0%,rgba(5,6,7,.16) 24%,rgba(5,6,7,.48) 68%,rgba(5,6,7,.94) 100%),
    radial-gradient(circle at 50% 50%,rgba(5,6,7,.08) 0%,rgba(5,6,7,.24) 52%,rgba(5,6,7,.5) 100%);
}
.hero-content{
  position:relative;
  z-index:2;
  min-height:100svh;
  display:flex;
  align-items:center;
  justify-content:center;
  padding-top:calc(var(--header-height) + clamp(34px,4.5vh,54px));
  padding-bottom:clamp(146px,16vh,178px);
}
.hero-stage{
  width:min(100%,1180px);
  margin-inline:auto;
  display:grid;
  grid-template-columns:repeat(12,minmax(0,1fr));
  column-gap:var(--grid-gap);
  align-content:center;
}
.hero-kicker{
  grid-column:2 / span 4;
  justify-self:start;
  width:max-content;
  max-width:100%;
  display:inline-flex;
  align-items:center;
  min-height:36px;
  margin:0 0 clamp(16px,2vh,24px);
  padding:8px 15px;
  border:1px solid rgba(255,255,255,.16);
  border-radius:999px;
  background:rgba(8,10,12,.42);
  color:#f0c977;
  box-shadow:0 10px 30px rgba(0,0,0,.16);
  backdrop-filter:blur(10px);
  -webkit-backdrop-filter:blur(10px);
  text-shadow:0 2px 14px rgba(0,0,0,.55);
}
.hero-title{
  grid-column:1 / -1;
  display:grid;
  grid-template-columns:repeat(12,minmax(0,1fr));
  column-gap:var(--grid-gap);
  width:100%;
  margin:0;
  line-height:.84;
  letter-spacing:-.058em;
  text-transform:uppercase;
}
.hero-title-line{
  display:block;
  width:max-content;
  max-width:100%;
  white-space:nowrap;
  text-shadow:0 18px 55px rgba(0,0,0,.34);
}
.hero-title-line--one{
  grid-column:2 / span 8;
  font-size:clamp(3rem,4.65vw,5.2rem);
  line-height:.92;
  letter-spacing:-.05em;
}
.hero-title-line--two{
  grid-column:2 / span 8;
  margin-top:clamp(7px,1vh,12px);
  font-size:clamp(5rem,8.55vw,9.2rem);
  line-height:.82;
  color:var(--accent);
}
.hero-title-line--three{
  grid-column:5 / span 7;
  margin-top:clamp(7px,1vh,13px);
  font-size:clamp(4.5rem,7.3vw,8rem);
  line-height:.84;
  color:var(--accent);
}
.hero-support{
  grid-column:1 / -1;
  display:grid;
  grid-template-columns:repeat(12,minmax(0,1fr));
  column-gap:var(--grid-gap);
  align-items:center;
  margin-top:clamp(24px,3vh,34px);
}
.hero-actions{
  grid-column:6 / span 6;
  display:flex;
  justify-content:flex-start;
  align-items:center;
  gap:14px;
  flex-wrap:wrap;
}
.hero-actions .btn{
  min-height:62px;
  padding-inline:30px;
  font-size:1rem;
  font-weight:800;
  box-shadow:0 14px 36px rgba(0,0,0,.2);
}
.hero-phone{
  min-width:240px;
  border-color:rgba(255,255,255,.34);
  background:rgba(0,0,0,.42);
  color:#fff;
}
.hero-bottom-copy{
  position:absolute;
  z-index:3;
  left:0;
  right:0;
  bottom:0;
  width:100%;
  min-height:118px;
  display:flex;
  align-items:center;
  border-top:1px solid rgba(255,255,255,.10);
  background:linear-gradient(180deg,rgba(6,7,8,.08) 0%,rgba(6,7,8,.58) 48%,rgba(6,7,8,.78) 100%);
}
.hero-bottom-copy-inner{
  width:100%;
  padding:26px clamp(40px,3.35vw,64px) 30px;
}
.hero-lead{
  width:100%;
  max-width:none;
  margin:0;
  text-align:center;
  font-size:clamp(1.04rem,1.2vw,1.22rem);
  line-height:1.55;
  color:#f0eee8;
  text-shadow:0 3px 18px rgba(0,0,0,.58);
  text-wrap:balance;
}
.hero-scroll{
  position:absolute;
  z-index:4;
  right:max(var(--page-gutter),24px);
  bottom:132px;
  font-size:.68rem;
  letter-spacing:.18em;
  color:#d0cec7;
  writing-mode:vertical-rl;
}
.hero-scroll span{font-size:1rem;margin-top:10px}

@media(max-width:1180px){
  .hero-bg{object-position:58% 50%}
  .hero-stage{width:min(100%,980px)}
  .hero-kicker{grid-column:1 / span 5}
  .hero-title-line--one{grid-column:1 / span 9;font-size:clamp(2.8rem,5.4vw,4.8rem)}
  .hero-title-line--two{grid-column:1 / span 9;font-size:clamp(4.8rem,9.5vw,8rem)}
  .hero-title-line--three{grid-column:4 / span 9;font-size:clamp(4.3rem,8.4vw,7.1rem)}
  .hero-actions{grid-column:6 / -1}
}

@media(max-width:900px){
  .hero{min-height:100svh}
  .hero-content{min-height:100svh;padding-top:calc(var(--header-height) + 42px);padding-bottom:154px}
  .hero-stage{width:min(100%,780px)}
  .hero-kicker{grid-column:1 / span 7}
  .hero-title-line--one{grid-column:1 / -1;font-size:clamp(2.55rem,7.5vw,4.2rem)}
  .hero-title-line--two{grid-column:1 / -1;font-size:clamp(4.4rem,13.2vw,7rem)}
  .hero-title-line--three{grid-column:3 / -1;font-size:clamp(4rem,11.8vw,6.4rem)}
  .hero-support{margin-top:28px}
  .hero-actions{grid-column:1 / span 10;display:flex;justify-content:flex-start}
  .hero-bottom-copy{min-height:112px}
  .hero-bottom-copy-inner{padding:22px var(--page-gutter) 24px}
  .hero-lead{font-size:1.02rem}
  .hero-scroll{display:none}
}

@media(max-width:620px){
  .hero-bg{object-position:64% center}
  .hero-overlay{
    background:
      linear-gradient(180deg,rgba(5,6,7,.28) 0%,rgba(5,6,7,.28) 34%,rgba(5,6,7,.78) 72%,rgba(5,6,7,.97) 100%),
      radial-gradient(circle at 50% 50%,rgba(5,6,7,.18),rgba(5,6,7,.5) 100%);
  }
  .hero-content{padding-top:calc(var(--header-height) + 34px);padding-bottom:176px}
  .hero-stage{display:block;width:100%}
  .hero-kicker{margin-bottom:16px;padding:7px 12px;min-height:34px}
  .hero-title{display:block}
  .hero-title-line{white-space:normal;width:auto}
  .hero-title-line--one{font-size:clamp(2.05rem,10.4vw,3rem);line-height:.95}
  .hero-title-line--two{margin-top:7px;font-size:clamp(3.9rem,18vw,5.4rem);line-height:.82}
  .hero-title-line--three{margin-top:5px;margin-left:clamp(20px,7vw,38px);font-size:clamp(3.5rem,16vw,4.8rem);line-height:.84}
  .hero-support{display:block;margin-top:22px}
  .hero-actions{display:grid;gap:10px}
  .hero-actions .btn{width:100%;min-height:58px;font-size:.98rem}
  .hero-bottom-copy{min-height:142px}
  .hero-bottom-copy-inner{padding:21px var(--page-gutter) 24px}
  .hero-lead{text-align:left;max-width:34ch;font-size:.98rem;line-height:1.5}
}
</style>
