---
const categories = [
  {
    title: 'Transport i montaż konstrukcji',
    services: [
      'Magazynowanie i konserwacja kontenerów',
      'Transport i montaż suwnic',
      'Transport domków holenderskich',
      'Transport i montaż stacji ładowania',
      'Transport i osadzanie agregatów prądotwórczych',
      'Transport i osadzanie magazynów energii',
      'Transport i osadzanie stacji transformatorowych',
    ],
  },
  {
    title: 'Budownictwo i infrastruktura',
    services: [
      'Transport i osadzanie baraków i stróżówek',
      'Transport i osadzanie domów szkieletowych',
      'Transport i rozładunek materiałów budowlanych',
      'Transport i rozładunek towarów sypkich w Big-Bagach',
      'Transport i osadzanie płyt drogowych MON',
      'Transport i osadzanie ogrodzeń',
      'Transport i osadzanie prefabrykatów',
      'Transport i osadzanie ekranów akustycznych',
      'Instalowanie kładek dla pieszych i wiaduktów',
      'Transport i rozładunek rusztowań i szalunków',
    ],
  },
  {
    title: 'Energetyka i przemysł',
    services: [
      'Transport i osadzanie masztów energetycznych',
      'Transport i osadzanie wiatraków energetycznych',
      'Transport i rozładunek maszyn i urządzeń',
      'Transport i rozładunek sprzętu budowlanego',
      'Transport i rozładunek zwojów kabli i kręgów',
      'Transport i rozładunek rur, słupów i latarni',
      'Transport i osadzanie sejfów, kas pancernych',
    ],
  },
  {
    title: 'Rolnictwo i rekreacja',
    services: [
      'Transport i osadzanie silosów rolniczych',
      'Transport i rozładunek maszyn rolniczych',
      'Transport i rozładunek trawy i siana w rolkach',
      'Transport i rozładunek łodzi i jachtów',
      'Transport Gołębników z zastosowaniem trawersa',
    ],
  },
  {
    title: 'Reklama i wydarzenia',
    services: [
      'Transport i montaż reklam, billboardów i paczkomatów',
      'Obsługa imprez masowych i eventów',
    ],
  },
] as const;
---
<section class="service-catalog" data-service-catalog aria-label="Pełny zakres usług HDS">
  <div class="service-catalog__stage">
    {categories.map((category, index) => (
      <article
        class="service-document"
        id={`service-document-${index}`}
        data-service-panel
        data-active={index === 0 ? 'true' : 'false'}
        data-state={index === 0 ? 'active' : 'idle'}
        aria-hidden={index === 0 ? 'false' : 'true'}
      >
        <div class="service-document__meta">
          <span>Kategoria usług</span>
          <strong>{String(index + 1).padStart(2, '0')} / {String(categories.length).padStart(2, '0')}</strong>
        </div>
        <h2>{category.title}</h2>
        <div class="service-document__underline" aria-hidden="true"><span></span></div>
        <ul>
          {category.services.map((service, serviceIndex) => (
            <li data-service-item style={`--service-index:${serviceIndex}`}>{service}</li>
          ))}
        </ul>
      </article>
    ))}
  </div>

  <nav class="service-catalog__controls" aria-label="Wybierz kategorię usług">
    {categories.map((category, index) => (
      <button
        type="button"
        data-service-nav-index={String(index)}
        aria-controls={`service-document-${index}`}
        aria-pressed={index === 0 ? 'true' : 'false'}
        aria-label={category.title}
        title={category.title}
      >
        <span class="service-catalog__control-arrow" aria-hidden="true">↑</span>
        <span class="service-catalog__control-number">{String(index + 1).padStart(2, '0')}</span>
      </button>
    ))}
  </nav>
</section>

<script is:inline>
  (() => {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.querySelectorAll('[data-service-catalog]').forEach((catalog) => {
      const panels = Array.from(catalog.querySelectorAll('[data-service-panel]'));
      const buttons = Array.from(catalog.querySelectorAll('[data-service-nav-index]'));
      if (panels.length < 2 || buttons.length !== panels.length) return;

      let activeIndex = Math.max(0, panels.findIndex((panel) => panel.getAttribute('data-active') === 'true'));
      let timer = null;
      let transitionTimer = null;

      const stop = () => {
        if (timer !== null) {
          window.clearInterval(timer);
          timer = null;
        }
      };

      const show = (nextIndex, restartTimer = true) => {
        if (!Number.isInteger(nextIndex) || nextIndex < 0 || nextIndex >= panels.length || nextIndex === activeIndex) {
          if (restartTimer) start();
          return;
        }

        const current = panels[activeIndex];
        const next = panels[nextIndex];
        if (transitionTimer !== null) window.clearTimeout(transitionTimer);

        current.setAttribute('data-active', 'false');
        current.setAttribute('data-state', reducedMotion ? 'idle' : 'leaving');
        current.setAttribute('aria-hidden', 'true');
        next.setAttribute('data-active', 'true');
        next.setAttribute('data-state', reducedMotion ? 'active' : 'entering');
        next.setAttribute('aria-hidden', 'false');

        buttons.forEach((button, index) => button.setAttribute('aria-pressed', index === nextIndex ? 'true' : 'false'));
        activeIndex = nextIndex;

        if (!reducedMotion) {
          requestAnimationFrame(() => requestAnimationFrame(() => next.setAttribute('data-state', 'active')));
          transitionTimer = window.setTimeout(() => {
            if (current.getAttribute('data-active') === 'false') current.setAttribute('data-state', 'idle');
          }, 520);
        }
        if (restartTimer) start();
      };

      const start = () => {
        stop();
        if (reducedMotion || document.hidden) return;
        timer = window.setInterval(() => show((activeIndex + 1) % panels.length, false), 5200);
      };

      buttons.forEach((button) => button.addEventListener('click', () => show(Number(button.getAttribute('data-service-nav-index')), true)));
      catalog.addEventListener('mouseenter', stop);
      catalog.addEventListener('mouseleave', start);
      catalog.addEventListener('focusin', stop);
      catalog.addEventListener('focusout', () => window.setTimeout(() => { if (!catalog.contains(document.activeElement)) start(); }, 0));
      document.addEventListener('visibilitychange', () => document.hidden ? stop() : start());
      start();
    });
  })();
</script>

<style>
.service-catalog{--catalog-backdrop-left:-17px;--catalog-backdrop-width:90%;--catalog-content-right-gap:8px;position:relative;width:100%;max-width:560px;min-width:0;isolation:isolate}.service-catalog__stage{position:relative;display:grid;min-height:420px;isolation:isolate}.service-catalog__stage::before{content:'';position:absolute;z-index:-1;top:-26px;bottom:-20px;left:var(--catalog-backdrop-left);width:var(--catalog-backdrop-width);background:rgba(7,9,11,.28);-webkit-backdrop-filter:blur(11px);backdrop-filter:blur(11px);border-radius:28px;-webkit-mask-image:radial-gradient(ellipse at center,#000 58%,rgba(0,0,0,.88) 72%,transparent 100%);mask-image:radial-gradient(ellipse at center,#000 58%,rgba(0,0,0,.88) 72%,transparent 100%);pointer-events:none}.service-document{position:relative;grid-area:1/1;display:flex;flex-direction:column;align-self:start;margin:0;padding:0;border:0;background:transparent;box-shadow:none;opacity:0;visibility:hidden;transform:translate3d(30px,10px,0);transition:opacity .34s ease,transform .48s cubic-bezier(.22,.7,.22,1),visibility .48s step-end;pointer-events:none}.service-document[data-state='entering'],.service-document[data-state='active'],.service-document[data-state='leaving']{visibility:visible;transition:opacity .34s ease,transform .48s cubic-bezier(.22,.7,.22,1),visibility 0s}.service-document[data-state='active']{z-index:3;opacity:1;transform:none;pointer-events:auto}.service-document[data-state='entering']{z-index:4;opacity:0;transform:translate3d(34px,12px,0)}.service-document[data-state='leaving']{z-index:2;opacity:0;transform:translate3d(-24px,-7px,0)}
.service-document__meta{display:flex;align-items:center;justify-content:space-between;gap:18px;width:calc(var(--catalog-backdrop-width) + var(--catalog-backdrop-left) - var(--catalog-content-right-gap));margin-bottom:14px;color:rgba(255,255,255,.48);font-size:.68rem;font-weight:720;letter-spacing:.15em;text-transform:uppercase}.service-document__meta strong{color:var(--accent);font-size:.68rem;letter-spacing:.1em}.service-document h2{max-width:18ch;margin:0;color:#f7f5f0;font-size:clamp(1.8rem,2.35vw,2.75rem);line-height:1.02;letter-spacing:-.04em;text-wrap:balance}.service-document__underline{width:calc(var(--catalog-backdrop-width) + var(--catalog-backdrop-left));height:1px;margin:18px 0 16px;background:rgba(255,255,255,.12);overflow:hidden}.service-document__underline span{display:block;width:clamp(72px,24%,138px);height:100%;background:var(--accent);transform-origin:left center;transition:transform .55s cubic-bezier(.2,.7,.2,1)}.service-document ul{display:grid;gap:2px;margin:0;padding:0;list-style:none}.service-document li{position:relative;padding:7px 0 7px 17px;color:rgba(247,245,240,.75);font-size:clamp(.82rem,.93vw,.96rem);line-height:1.36;opacity:0;transform:translateY(8px);transition:opacity .3s ease,transform .42s ease;transition-delay:calc(var(--service-index) * 28ms)}.service-document li::before{content:'';position:absolute;left:0;top:50%;width:7px;height:1px;background:rgba(215,180,106,.88);transform:translateY(-50%)}.service-document[data-state='active'] li{opacity:1;transform:none}.service-document[data-state='entering'] .service-document__underline span{transform:scaleX(.18)}
.service-catalog__controls{display:flex;align-items:center;justify-content:center;gap:20px;width:var(--catalog-backdrop-width);margin-top:30px;margin-left:var(--catalog-backdrop-left);padding-top:2px;position:relative;z-index:6}.service-catalog__controls button{position:relative;display:inline-flex;align-items:center;gap:6px;min-width:38px;padding:6px 0 9px;border:0;background:transparent;color:rgba(255,255,255,.48);font:inherit;font-size:clamp(.82rem,.9vw,.94rem);font-weight:780;line-height:1;letter-spacing:.055em;cursor:pointer;transition:color .2s ease,transform .2s ease}.service-catalog__control-arrow{display:inline-block;color:rgba(215,180,106,.62);font-size:.9em;line-height:1;transform:translateY(1px);transition:color .2s ease,transform .2s ease}.service-catalog__control-number{display:inline-block}.service-catalog__controls button::after{content:'';position:absolute;left:0;right:100%;bottom:2px;height:1px;background:var(--accent);transition:right .25s ease}.service-catalog__controls button:hover{color:#fff}.service-catalog__controls button:hover .service-catalog__control-arrow{color:var(--accent-strong);transform:translateY(-1px)}.service-catalog__controls button[aria-pressed='true']{color:#f4d58b}.service-catalog__controls button[aria-pressed='true'] .service-catalog__control-arrow{color:#f4d58b;transform:translateY(-2px)}.service-catalog__controls button[aria-pressed='true']::after{right:0}
@media(max-width:1180px){.service-catalog{--catalog-backdrop-left:-13px;max-width:680px}.service-catalog__stage{min-height:430px}.service-catalog__stage::before{top:-22px;bottom:-18px}}
@media(max-width:620px){.service-catalog{--catalog-backdrop-left:-7px}.service-catalog__stage{min-height:510px}.service-document__meta{font-size:.61rem}.service-document__meta strong{font-size:.62rem}.service-document h2{font-size:clamp(1.65rem,8vw,2.15rem)}.service-document li{padding-top:6px;padding-bottom:6px;font-size:.78rem}.service-catalog__controls{gap:10px;margin-top:26px}.service-catalog__controls button{min-width:40px;font-size:.84rem}.service-catalog__stage::before{top:-18px;bottom:-16px;-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px)}}
@media(prefers-reduced-motion:reduce){.service-document,.service-document li,.service-document__underline span,.service-catalog__controls button,.service-catalog__control-arrow,.service-catalog__controls button::after{transition:none!important}.service-document[data-state='active'] li{opacity:1;transform:none}}
</style>
