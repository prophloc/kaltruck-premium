---
import { siteConfig } from '../config/site';
import MobileMenu from './MobileMenu.astro';
const nav = [
  ['Usługi', '/transport-hds/'],
  ['Realizacje', '/realizacje/'],
  ['Sprzęt', '/sprzet/'],
  ['O nas', '/o-nas/'],
  ['Kontakt', '/kontakt/'],
] as const;
const pathname = Astro.url.pathname;
const isServicePath = pathname.startsWith('/transport-') || pathname.startsWith('/rozladunek-hds') || pathname.startsWith('/wynajem-hds');
const activeHref = isServicePath
  ? '/transport-hds/'
  : nav.find(([, href]) => pathname === href || pathname === href.slice(0, -1))?.[1];
const headerServices = [
  'Kontenery i magazynowanie',
  'Suwnice przemysłowe',
  'Domki holenderskie',
  'Stacje ładowania',
  'Agregaty prądotwórcze',
  'Magazyny energii',
  'Stacje transformatorowe',
  'Baraki i stróżówki',
  'Domy szkieletowe',
  'Materiały budowlane',
  'Big-Bagi',
  'Płyty drogowe MON',
  'Ogrodzenia',
  'Prefabrykaty',
  'Ekrany akustyczne',
  'Kładki i wiadukty',
  'Rusztowania i szalunki',
  'Maszty energetyczne',
  'Wiatraki energetyczne',
  'Maszyny i urządzenia',
  'Sprzęt budowlany',
  'Zwoje kabli i kręgi',
  'Rury, słupy i latarnie',
  'Sejfy i kasy pancerne',
  'Silosy rolnicze',
  'Maszyny rolnicze',
  'Trawa i siano w rolkach',
  'Łodzie i jachty',
  'Gołębniki z trawersem',
  'Reklamy, billboardy i paczkomaty',
  'Eventy i imprezy masowe',
] as const;
---
<header class="site-header" data-header>
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="KALTRUCK Transport HDS — strona główna">
      <img data-brand-logo class="brand-logo" src="/brand/kaltruck-logo.svg" width="2548" height="1305" alt="KALTRUCK Transport HDS" />
    </a>

    <div class="header-actions">
      <a class="phone-link" href={`tel:${siteConfig.phone}`}>514 948 373</a>
      <a class="phone-link phone-link--secondary" href={`tel:${siteConfig.secondaryPhone}`}>784 430 022</a>
      <a class="quote-link" href="/wycena/">Wyceń transport</a>
      <a class="email-link" href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
      <button class="menu-button" type="button" aria-label="Otwórz menu" aria-controls="mobile-menu" aria-expanded="false" data-menu-open>
        <span></span><span></span>
      </button>
    </div>

    <div
      class="service-rotator"
      data-service-rotator
      data-services={JSON.stringify(headerServices)}
      aria-hidden="true"
    >
      <span class="service-rotator-label" data-service-rotator-label>{headerServices[0]}</span>
    </div>

    <nav class="desktop-nav" aria-label="Nawigacja główna">
      {nav.map(([label, href]) => <a href={href} aria-current={activeHref === href ? 'page' : undefined}>{label}</a>)}
    </nav>
  </div>
</header>
<MobileMenu activeHref={activeHref} />
<noscript>
  <nav class="nojs-nav" aria-label="Nawigacja bez JavaScript">
    <a href="/transport-hds/">Usługi</a>
    <a href="/realizacje/">Realizacje</a>
    <a href="/sprzet/">Sprzęt</a>
    <a href="/o-nas/">O nas</a>
    <a href="/kontakt/">Kontakt</a>
    <a href="/wycena/">Wyceń transport</a>
    <a href={`tel:${siteConfig.phone}`}>514 948 373</a>
    <a href={`tel:${siteConfig.secondaryPhone}`}>784 430 022</a>
    <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
  </nav>
  <style>
    @media (max-width: 1080px) {
      .nojs-nav { position: fixed; z-index: 59; top: var(--header-height); left: 0; right: 0; display: flex; gap: 16px; overflow-x: auto; padding: 12px var(--page-gutter); background: #0a0b0c; border-bottom: 1px solid var(--line); white-space: nowrap; }
      .menu-button { display: none !important; }
    }
    @media (min-width: 1081px) { .nojs-nav { display: none; } }
  </style>
</noscript>

<script is:inline>
  (() => {
    const header = document.querySelector('[data-header]');
    const menu = document.querySelector('[data-mobile-menu]');
    const open = document.querySelector('[data-menu-open]');
    const close = document.querySelector('[data-menu-close]');
    const rotator = document.querySelector('[data-service-rotator]');
    const rotatorLabel = rotator?.querySelector('[data-service-rotator-label]');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const setOpen = (value) => {
      if (!menu || !open) return;
      menu.dataset.open = value ? 'true' : 'false';
      open.setAttribute('aria-expanded', String(value));
      document.documentElement.style.overflow = value ? 'hidden' : '';
    };
    open?.addEventListener('click', () => setOpen(true));
    close?.addEventListener('click', () => setOpen(false));
    menu?.addEventListener('click', (event) => { if (event.target === menu) setOpen(false); });
    document.addEventListener('keydown', (event) => { if (event.key === 'Escape') setOpen(false); });
    const updateHeader = () => header?.classList.toggle('is-scrolled', window.scrollY > 24);
    updateHeader();
    addEventListener('scroll', updateHeader, { passive: true });

    if (rotator && rotatorLabel && !reducedMotion) {
      let services = [];
      try {
        services = JSON.parse(rotator.getAttribute('data-services') || '[]');
      } catch {
        services = [];
      }
      if (services.length > 1) {
        let serviceIndex = 0;
        setInterval(() => {
          rotatorLabel.classList.add('is-leaving');
          setTimeout(() => {
            serviceIndex = (serviceIndex + 1) % services.length;
            rotatorLabel.textContent = services[serviceIndex];
            rotatorLabel.classList.remove('is-leaving');
            rotatorLabel.classList.add('is-entering');
            requestAnimationFrame(() => {
              requestAnimationFrame(() => rotatorLabel.classList.remove('is-entering'));
            });
          }, 180);
        }, 2800);
      }
    }
  })();
</script>

<style>
  .site-header {
    position: fixed;
    top: 0;
    inset-inline: 0;
    z-index: 60;
    height: var(--header-height);
    display: flex;
    align-items: center;
    border-bottom: 1px solid rgba(255,255,255,.07);
    background: transparent;
    isolation: isolate;
    transition: background .25s ease, border-color .25s ease;
  }
  .site-header::before {
    content: '';
    position: absolute;
    z-index: 0;
    top: 0;
    left: 0;
    right: 0;
    height: clamp(190px, 20vh, 230px);
    pointer-events: none;
    background: linear-gradient(180deg,rgba(4,5,7,.92) 0%,rgba(4,5,7,.78) 26%,rgba(4,5,7,.52) 50%,rgba(4,5,7,.24) 72%,rgba(4,5,7,0) 100%);
    transition: opacity .25s ease, height .25s ease;
  }
  .site-header.is-scrolled { background: rgba(10,11,12,.94); border-color: var(--line); }
  .site-header.is-scrolled::before { height: calc(var(--header-height) + 42px); opacity: .72; }
  .header-inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: clamp(9px, .8vw, 14px);
    width: 100%;
    max-width: none;
    margin-inline: 0;
    padding-inline: clamp(40px, 3.35vw, 64px);
  }
  .brand { display: inline-flex; align-items: center; flex: 0 0 auto; min-width: 0; }
  .brand-logo {
    display: block;
    width: clamp(168px, 11vw, 188px);
    height: auto;
    max-height: 80px;
    filter: invert(1) drop-shadow(0 8px 24px rgba(0,0,0,.3));
  }
  .header-actions { display: flex; align-items: center; gap: 5px; flex: 0 0 auto; }
  .phone-link,
  .email-link,
  .quote-link {
    min-height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    white-space: nowrap;
    font-size: .78rem;
    font-weight: 740;
    line-height: 1;
    transition: border-color .2s ease, background .2s ease, color .2s ease, transform .2s ease;
  }
  .phone-link {
    padding-inline: 11px;
    border: 1px solid rgba(255,255,255,.19);
    background: rgba(8,10,12,.10);
    color: #fff;
    text-shadow: 0 2px 14px rgba(0,0,0,.45);
  }
  .email-link {
    min-height: auto;
    padding: 8px 7px;
    border-radius: 8px;
    color: rgba(255,255,255,.77);
    font-size: .72rem;
    font-weight: 650;
  }
  .quote-link {
    padding-inline: 14px;
    border: 1px solid rgba(215,180,106,.58);
    background: rgba(215,180,106,.08);
    color: #f0c977;
  }
  .phone-link:hover,
  .email-link:hover,
  .quote-link:hover { transform: translateY(-1px); }
  .phone-link:hover { border-color: rgba(255,255,255,.42); background: rgba(8,10,12,.30); }
  .email-link:hover { color: #fff; background: rgba(255,255,255,.06); }
  .quote-link:hover { border-color: var(--accent); background: rgba(215,180,106,.15); color: #f7d995; }
  .service-rotator {
    flex: 1 1 auto;
    min-width: 0;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-inline: clamp(10px,1.6vw,28px);
    overflow: hidden;
    pointer-events: none;
  }
  .service-rotator-label {
    display: block;
    min-width: 0;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: rgba(244,241,234,.82);
    font-size: clamp(.72rem,.72vw,.82rem);
    font-weight: 720;
    line-height: 1;
    letter-spacing: .075em;
    text-transform: uppercase;
    text-shadow: 0 2px 16px rgba(0,0,0,.7);
    opacity: 1;
    transform: translateY(0);
    transition: opacity .22s ease, transform .28s cubic-bezier(.22,.61,.36,1), color .22s ease;
  }
  .service-rotator-label.is-leaving { opacity: 0; transform: translateY(-7px); }
  .service-rotator-label.is-entering { opacity: 0; transform: translateY(7px); transition: none; }
  .desktop-nav {
    margin-left: 0;
    display: flex;
    align-items: center;
    gap: clamp(12px, 1.1vw, 18px);
    flex: 0 0 auto;
  }
  .desktop-nav a {
    color: #fff;
    font-size: .97rem;
    font-weight: 750;
    line-height: 1;
    white-space: nowrap;
    text-shadow: 0 2px 18px rgba(0,0,0,.82);
    transition: color .2s ease, opacity .2s ease;
  }
  .desktop-nav a:hover,
  .desktop-nav a[aria-current="page"] { color: var(--accent-strong); }
  .menu-button { display: none; width: 46px; height: 46px; flex: 0 0 auto; border: 1px solid rgba(255,255,255,.26); border-radius: 50%; background: rgba(0,0,0,.24); padding: 0 12px; color: var(--text); }
  .menu-button span { display: block; height: 1px; background: currentColor; margin: 6px 0; }

  @media (max-width: 1600px) {
    .email-link { display: none; }
  }
  @media (max-width: 1460px) {
    .service-rotator { display: none; }
    .desktop-nav { margin-left: auto; }
  }
  @media (max-width: 1320px) and (min-width: 1181px) {
    .header-inner { gap: 8px; padding-inline: 40px; }
    .brand-logo { width: 158px; }
    .header-actions { gap: 4px; }
    .phone-link,
    .quote-link { min-height: 39px; font-size: .76rem; }
    .phone-link { padding-inline: 9px; }
    .quote-link { padding-inline: 12px; }
    .desktop-nav { gap: 11px; }
    .desktop-nav a { font-size: .88rem; }
  }
  @media (max-width: 1180px) and (min-width: 1081px) {
    .header-inner { gap: 10px; padding-inline: 34px; }
    .brand-logo { width: 150px; }
    .header-actions { gap: 5px; }
    .phone-link, .email-link { display: none; }
    .quote-link { min-height: 40px; padding-inline: 13px; font-size: .81rem; }
    .desktop-nav { gap: 12px; }
    .desktop-nav a { font-size: .89rem; }
  }
  @media (max-width: 1080px) {
    .header-inner { padding-inline: var(--page-gutter); }
    .desktop-nav, .phone-link, .email-link, .service-rotator { display: none; }
    .header-actions { margin-left: auto; }
    .quote-link { min-height: 44px; padding-inline: 16px; }
    .menu-button { display: block; }
    .brand-logo { width: 142px; max-height: 70px; }
    .site-header::before { height: 185px; }
  }
  @media (max-width: 620px) {
    .quote-link { display: none; }
    .brand-logo { width: 130px; max-height: 66px; }
    .site-header::before { height: 165px; }
  }
  @media (prefers-reduced-motion: reduce) { .service-rotator-label { transition: none; } }
</style>