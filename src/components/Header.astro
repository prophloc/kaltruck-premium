---
import { siteConfig } from '../config/site';
import MobileMenu from './MobileMenu.astro';
const nav = [
  ['Usługi', '/transport-hds/'],
  ['Realizacje', '/realizacje/'],
  ['Sprzęt', '/sprzet/'],
  ['O nas', '/o-nas/'],
  ['Kontakt', '/kontakt/'],
] as const;
---
<header class="site-header" data-header>
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="KALTRUCK Transport HDS — strona główna">
      <img class="brand-logo" src="/brand/kaltruck-logo.svg" width="2548" height="1305" alt="KALTRUCK Transport HDS" />
    </a>
    <nav class="desktop-nav" aria-label="Nawigacja główna">
      {nav.map(([label, href]) => <a href={href}>{label}</a>)}
    </nav>
    <div class="header-actions">
      <a class="phone-link" href={`tel:${siteConfig.phone}`}>514 948 373</a>
      <a class="btn btn-primary quote-link" href="/wycena/">Wyceń transport</a>
      <button class="menu-button" type="button" aria-label="Otwórz menu" aria-controls="mobile-menu" aria-expanded="false" data-menu-open>
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>
<MobileMenu />
<noscript>
  <nav class="nojs-nav" aria-label="Nawigacja bez JavaScript">
    <a href="/transport-hds/">Usługi</a>
    <a href="/realizacje/">Realizacje</a>
    <a href="/sprzet/">Sprzęt</a>
    <a href="/o-nas/">O nas</a>
    <a href="/kontakt/">Kontakt</a>
    <a href="/wycena/">Wyceń transport</a>
    <a href={`tel:${siteConfig.phone}`}>Zadzwoń</a>
  </nav>
  <style>
    @media (max-width: 1080px) {
      .nojs-nav { position: fixed; z-index: 59; top: var(--header-height); left: 0; right: 0; display: flex; gap: 16px; overflow-x: auto; padding: 12px var(--page-gutter); background: #0a0b0c; border-bottom: 1px solid var(--line); white-space: nowrap; }
      .menu-button { display: none !important; }
    }
    @media (min-width: 1081px) { .nojs-nav { display: none; } }
  </style>
</noscript>

<script is:inline>
  (() => {
    const header = document.querySelector('[data-header]');
    const menu = document.querySelector('[data-mobile-menu]');
    const open = document.querySelector('[data-menu-open]');
    const close = document.querySelector('[data-menu-close]');
    const setOpen = (value) => {
      if (!menu || !open) return;
      menu.dataset.open = value ? 'true' : 'false';
      open.setAttribute('aria-expanded', String(value));
      document.documentElement.style.overflow = value ? 'hidden' : '';
    };
    open?.addEventListener('click', () => setOpen(true));
    close?.addEventListener('click', () => setOpen(false));
    menu?.addEventListener('click', (event) => { if (event.target === menu) setOpen(false); });
    document.addEventListener('keydown', (event) => { if (event.key === 'Escape') setOpen(false); });
    const updateHeader = () => header?.classList.toggle('is-scrolled', window.scrollY > 24);
    updateHeader();
    addEventListener('scroll', updateHeader, { passive: true });
  })();
</script>

<style>
  .site-header {
    position: fixed;
    top: 0;
    inset-inline: 0;
    z-index: 60;
    height: var(--header-height);
    display: flex;
    align-items: center;
    border-bottom: 1px solid rgba(255,255,255,.08);
    background: linear-gradient(180deg, rgba(5,6,7,.7) 0%, rgba(5,6,7,.34) 70%, rgba(5,6,7,.06) 100%);
    transition: background .25s ease, border-color .25s ease, backdrop-filter .25s ease;
  }
  .site-header.is-scrolled { background: rgba(10,11,12,.94); border-color: var(--line); backdrop-filter: blur(18px); }
  .header-inner { display: flex; align-items: center; gap: clamp(20px, 2vw, 34px); width: 100%; }
  .brand { display: inline-flex; align-items: center; flex: 0 0 auto; min-width: 0; }
  .brand-logo {
    display: block;
    width: clamp(132px, 10vw, 158px);
    height: auto;
    max-height: 72px;
    filter: invert(1) drop-shadow(0 8px 24px rgba(0,0,0,.3));
  }
  .desktop-nav { margin-left: auto; display: flex; align-items: center; gap: clamp(18px, 1.6vw, 27px); }
  .desktop-nav a {
    color: #fff;
    font-size: .98rem;
    font-weight: 750;
    line-height: 1;
    white-space: nowrap;
    text-shadow: 0 2px 16px rgba(0,0,0,.78);
    transition: color .2s ease, opacity .2s ease;
  }
  .desktop-nav a:hover { color: var(--accent-strong); }
  .header-actions { display: flex; align-items: center; gap: 12px; }
  .phone-link {
    min-height: 52px;
    display: inline-flex;
    align-items: center;
    padding-inline: 18px;
    border: 1px solid rgba(255,255,255,.28);
    border-radius: 999px;
    background: rgba(0,0,0,.28);
    color: #fff;
    font-weight: 800;
    font-size: .98rem;
    white-space: nowrap;
    text-shadow: 0 2px 14px rgba(0,0,0,.55);
    backdrop-filter: blur(10px);
  }
  .quote-link { min-height: 56px; padding-inline: 26px; font-size: .96rem; font-weight: 800; white-space: nowrap; }
  .menu-button { display: none; width: 52px; height: 52px; flex: 0 0 auto; border: 1px solid rgba(255,255,255,.3); border-radius: 50%; background: rgba(0,0,0,.36); padding: 0 14px; color: var(--text); }
  .menu-button span { display: block; height: 1px; background: currentColor; margin: 6px 0; }

  @media (max-width: 1320px) and (min-width: 1181px) {
    .brand-logo { width: 138px; }
    .header-inner { gap: 16px; }
    .desktop-nav { gap: 16px; }
    .desktop-nav a { font-size: .92rem; }
    .phone-link { min-height: 48px; padding-inline: 15px; font-size: .92rem; }
    .quote-link { min-height: 50px; padding-inline: 19px; font-size: .91rem; }
  }
  @media (max-width: 1180px) and (min-width: 1081px) {
    .brand-logo { width: 134px; }
    .header-inner { gap: 16px; }
    .desktop-nav { gap: 15px; }
    .desktop-nav a { font-size: .9rem; }
    .phone-link { display: none; }
    .quote-link { min-height: 50px; padding-inline: 19px; }
  }
  @media (max-width: 1080px) {
    .desktop-nav, .phone-link { display: none; }
    .header-actions { margin-left: auto; }
    .menu-button { display: block; }
    .brand-logo { width: 134px; max-height: 68px; }
  }
  @media (max-width: 620px) {
    .quote-link { display: none; }
    .brand-logo { width: 124px; max-height: 64px; }
  }
</style>
