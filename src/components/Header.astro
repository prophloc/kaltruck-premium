---
import { siteConfig } from '../config/site';
import MobileMenu from './MobileMenu.astro';
const nav = [
  ['Usługi', '/transport-hds/'],
  ['Realizacje', '/realizacje/'],
  ['Sprzęt', '/sprzet/'],
  ['O nas', '/o-nas/'],
  ['Kontakt', '/kontakt/'],
] as const;
---
<header class="site-header" data-header>
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="KALTRUCK Transport HDS — strona główna">
      <img data-brand-logo class="brand-logo" src="/brand/kaltruck-logo.svg" width="2548" height="1305" alt="KALTRUCK Transport HDS" />
    </a>

    <div class="header-actions">
      <a class="phone-link" href={`tel:${siteConfig.phone}`}>514 948 373</a>
      <a class="quote-link" href="/wycena/">Wyceń transport</a>
      <button class="menu-button" type="button" aria-label="Otwórz menu" aria-controls="mobile-menu" aria-expanded="false" data-menu-open>
        <span></span><span></span>
      </button>
    </div>

    <nav class="desktop-nav" aria-label="Nawigacja główna">
      {nav.map(([label, href]) => <a href={href}>{label}</a>)}
    </nav>
  </div>
</header>
<MobileMenu />
<noscript>
  <nav class="nojs-nav" aria-label="Nawigacja bez JavaScript">
    <a href="/transport-hds/">Usługi</a>
    <a href="/realizacje/">Realizacje</a>
    <a href="/sprzet/">Sprzęt</a>
    <a href="/o-nas/">O nas</a>
    <a href="/kontakt/">Kontakt</a>
    <a href="/wycena/">Wyceń transport</a>
    <a href={`tel:${siteConfig.phone}`}>Zadzwoń</a>
  </nav>
  <style>
    @media (max-width: 1080px) {
      .nojs-nav { position: fixed; z-index: 59; top: var(--header-height); left: 0; right: 0; display: flex; gap: 16px; overflow-x: auto; padding: 12px var(--page-gutter); background: #0a0b0c; border-bottom: 1px solid var(--line); white-space: nowrap; }
      .menu-button { display: none !important; }
    }
    @media (min-width: 1081px) { .nojs-nav { display: none; } }
  </style>
</noscript>

<script is:inline>
  (() => {
    const header = document.querySelector('[data-header]');
    const menu = document.querySelector('[data-mobile-menu]');
    const open = document.querySelector('[data-menu-open]');
    const close = document.querySelector('[data-menu-close]');
    const setOpen = (value) => {
      if (!menu || !open) return;
      menu.dataset.open = value ? 'true' : 'false';
      open.setAttribute('aria-expanded', String(value));
      document.documentElement.style.overflow = value ? 'hidden' : '';
    };
    open?.addEventListener('click', () => setOpen(true));
    close?.addEventListener('click', () => setOpen(false));
    menu?.addEventListener('click', (event) => { if (event.target === menu) setOpen(false); });
    document.addEventListener('keydown', (event) => { if (event.key === 'Escape') setOpen(false); });
    const updateHeader = () => header?.classList.toggle('is-scrolled', window.scrollY > 24);
    updateHeader();
    addEventListener('scroll', updateHeader, { passive: true });
  })();
</script>

<style>
  .site-header {
    position: fixed;
    top: 0;
    inset-inline: 0;
    z-index: 60;
    height: var(--header-height);
    display: flex;
    align-items: center;
    border-bottom: 1px solid rgba(255,255,255,.07);
    background: transparent;
    isolation: isolate;
    transition: background .25s ease, border-color .25s ease;
  }
  .site-header::before {
    content: '';
    position: absolute;
    z-index: 0;
    top: 0;
    left: 0;
    right: 0;
    height: clamp(190px, 20vh, 230px);
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgba(4,5,7,.92) 0%,
      rgba(4,5,7,.78) 26%,
      rgba(4,5,7,.52) 50%,
      rgba(4,5,7,.24) 72%,
      rgba(4,5,7,0) 100%
    );
    transition: opacity .25s ease, height .25s ease;
  }
  .site-header.is-scrolled {
    background: rgba(10,11,12,.94);
    border-color: var(--line);
  }
  .site-header.is-scrolled::before {
    height: calc(var(--header-height) + 42px);
    opacity: .72;
  }
  .header-inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: clamp(18px, 1.5vw, 24px);
    width: 100%;
    max-width: none;
    margin-inline: 0;
    padding-inline: clamp(40px, 3.35vw, 64px);
  }
  .brand { display: inline-flex; align-items: center; flex: 0 0 auto; min-width: 0; }
  .brand-logo {
    display: block;
    width: clamp(168px, 11vw, 188px);
    height: auto;
    max-height: 80px;
    filter: invert(1) drop-shadow(0 8px 24px rgba(0,0,0,.3));
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: 0 0 auto;
  }
  .phone-link,
  .quote-link {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    white-space: nowrap;
    font-size: .86rem;
    font-weight: 760;
    line-height: 1;
    transition: border-color .2s ease, background .2s ease, color .2s ease, transform .2s ease;
  }
  .phone-link {
    padding-inline: 15px;
    border: 1px solid rgba(255,255,255,.24);
    background: rgba(8,10,12,.18);
    color: #fff;
    text-shadow: 0 2px 14px rgba(0,0,0,.45);
  }
  .quote-link {
    padding-inline: 17px;
    border: 1px solid rgba(215,180,106,.62);
    background: rgba(215,180,106,.10);
    color: #f0c977;
  }
  .phone-link:hover,
  .quote-link:hover {
    transform: translateY(-1px);
  }
  .phone-link:hover {
    border-color: rgba(255,255,255,.42);
    background: rgba(8,10,12,.34);
  }
  .quote-link:hover {
    border-color: var(--accent);
    background: rgba(215,180,106,.17);
    color: #f7d995;
  }
  .desktop-nav {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: clamp(18px, 1.6vw, 27px);
  }
  .desktop-nav a {
    color: #fff;
    font-size: .98rem;
    font-weight: 750;
    line-height: 1;
    white-space: nowrap;
    text-shadow: 0 2px 18px rgba(0,0,0,.82);
    transition: color .2s ease, opacity .2s ease;
  }
  .desktop-nav a:hover { color: var(--accent-strong); }
  .menu-button { display: none; width: 46px; height: 46px; flex: 0 0 auto; border: 1px solid rgba(255,255,255,.26); border-radius: 50%; background: rgba(0,0,0,.24); padding: 0 12px; color: var(--text); }
  .menu-button span { display: block; height: 1px; background: currentColor; margin: 6px 0; }

  @media (max-width: 1320px) and (min-width: 1181px) {
    .header-inner { gap: 14px; padding-inline: 40px; }
    .brand-logo { width: 158px; }
    .header-actions { gap: 6px; }
    .phone-link,
    .quote-link { min-height: 42px; font-size: .81rem; }
    .phone-link { padding-inline: 12px; }
    .quote-link { padding-inline: 14px; }
    .desktop-nav { gap: 15px; }
    .desktop-nav a { font-size: .91rem; }
  }
  @media (max-width: 1180px) and (min-width: 1081px) {
    .header-inner { padding-inline: 34px; }
    .brand-logo { width: 150px; }
    .header-actions { gap: 6px; }
    .phone-link { display: none; }
    .quote-link { min-height: 42px; padding-inline: 14px; font-size: .82rem; }
    .desktop-nav { gap: 15px; }
    .desktop-nav a { font-size: .9rem; }
  }
  @media (max-width: 1080px) {
    .header-inner { padding-inline: var(--page-gutter); }
    .desktop-nav, .phone-link { display: none; }
    .header-actions { margin-left: auto; }
    .quote-link { min-height: 44px; padding-inline: 16px; }
    .menu-button { display: block; }
    .brand-logo { width: 142px; max-height: 70px; }
    .site-header::before { height: 185px; }
  }
  @media (max-width: 620px) {
    .quote-link { display: none; }
    .brand-logo { width: 130px; max-height: 66px; }
    .site-header::before { height: 165px; }
  }
</style>
