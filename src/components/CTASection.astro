---
import { siteConfig } from '../config/site';
---
<section class="cta">
  <div class="container">
    <div class="cta-panel">
      <div class="cta-copy">
        <p class="eyebrow">Masz ładunek do przewiezienia?</p>
        <h2>Powiedz co, skąd i dokąd.<br /><span>My zajmiemy się resztą.</span></h2>
      </div>
      <div class="cta-actions-wrap">
        <p>Podaj podstawowe informacje o ładunku i trasie. Wrócimy z konkretną wyceną.</p>
        <div class="cta-actions">
          <a class="btn btn-primary" href="/wycena/">Wyceń transport</a>
          <a class="btn btn-secondary" href={`tel:${siteConfig.phone}`}>+48 514 948 373</a>
        </div>
      </div>
    </div>
  </div>
</section>
<style>
  .cta{padding:clamp(46px,4.5vw,62px) 0;background:#08090a;border-top:1px solid var(--line)}
  .cta-panel{
    position:relative;
    display:grid;
    grid-template-columns:repeat(12,minmax(0,1fr));
    gap:var(--grid-gap);
    align-items:center;
    padding:30px 0 26px;
    border:0;
    border-radius:0;
    background:transparent;
    box-shadow:none;
  }
  .cta-panel::before{
    content:'';
    position:absolute;
    top:0;
    left:0;
    width:78px;
    height:1px;
    background:var(--accent);
    opacity:.9;
  }
  .cta-copy{grid-column:1 / span 7}
  .cta .eyebrow{margin:0 0 14px}
  .cta h2{font-size:clamp(2.65rem,4.35vw,4.85rem);line-height:.94;letter-spacing:-.052em;margin:0;max-width:10ch;text-wrap:balance}
  .cta h2 span{color:var(--accent)}
  .cta-actions-wrap{grid-column:9 / -1;align-self:center;max-width:27rem}
  .cta-actions-wrap>p{margin:0;color:#b8b4ac;font-size:.96rem;line-height:1.58;max-width:35ch}
  .cta-actions{display:grid;gap:10px;margin-top:18px}
  .cta-actions .btn{width:100%;min-height:52px;justify-content:center}
  @media(max-width:980px){.cta-copy{grid-column:1 / span 7}.cta-actions-wrap{grid-column:8 / -1}.cta-panel{padding:28px 0 24px}}
  @media(max-width:760px){
    .cta{padding:40px 0}
    .cta-panel{grid-template-columns:1fr;gap:24px;padding:24px 0 20px}
    .cta-copy,.cta-actions-wrap{grid-column:auto}
    .cta h2{max-width:100%;font-size:clamp(2.45rem,10.5vw,4rem)}
    .cta-actions-wrap{max-width:100%}
    .cta-actions{grid-template-columns:1fr}
  }
</style>
