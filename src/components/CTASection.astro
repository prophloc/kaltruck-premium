---
import { siteConfig } from '../config/site';
---
<section class="cta">
  <div class="container">
    <div class="cta-panel">
      <div class="cta-copy">
        <p class="eyebrow">Masz ładunek do przewiezienia?</p>
        <h2>Powiedz co, skąd i dokąd.<br /><span>My zajmiemy się resztą.</span></h2>
      </div>
      <div class="cta-actions-wrap">
        <p>Podaj podstawowe informacje o ładunku i trasie. Wrócimy z konkretną wyceną.</p>
        <div class="cta-actions">
          <a class="btn btn-primary" href="/wycena/">Wyceń transport</a>
          <a class="btn btn-secondary" href={`tel:${siteConfig.phone}`}>+48 514 948 373</a>
        </div>
      </div>
    </div>
  </div>
</section>
<style>
  .cta{padding:clamp(72px,7vw,104px) 0;background:#08090a;border-top:1px solid var(--line)}
  .cta-panel{
    display:grid;
    grid-template-columns:repeat(12,minmax(0,1fr));
    gap:var(--grid-gap);
    align-items:end;
    padding:clamp(44px,5vw,72px);
    border:1px solid rgba(255,255,255,.09);
    border-radius:18px;
    background:
      radial-gradient(circle at 92% 22%,rgba(215,180,106,.14),transparent 30%),
      linear-gradient(135deg,#121518 0%,#0a0c0d 72%);
    box-shadow:0 28px 80px rgba(0,0,0,.2);
  }
  .cta-copy{grid-column:1 / span 7}
  .cta .eyebrow{margin:0 0 18px}
  .cta h2{font-size:clamp(3rem,5.2vw,5.9rem);line-height:.93;letter-spacing:-.055em;margin:0;max-width:10ch;text-wrap:balance}
  .cta h2 span{color:var(--accent)}
  .cta-actions-wrap{grid-column:9 / -1;align-self:end;max-width:28rem}
  .cta-actions-wrap>p{margin:0;color:#b8b4ac;font-size:1rem;line-height:1.65;max-width:36ch}
  .cta-actions{display:grid;gap:10px;margin-top:24px}
  .cta-actions .btn{width:100%;min-height:56px;justify-content:center}
  @media(max-width:980px){.cta-copy{grid-column:1 / span 7}.cta-actions-wrap{grid-column:8 / -1}.cta-panel{padding:42px}}
  @media(max-width:760px){
    .cta{padding:50px 0}
    .cta-panel{grid-template-columns:1fr;gap:30px;padding:30px;border-radius:12px}
    .cta-copy,.cta-actions-wrap{grid-column:auto}
    .cta h2{max-width:100%;font-size:clamp(2.65rem,12vw,4.45rem)}
    .cta-actions-wrap{max-width:100%}
    .cta-actions{grid-template-columns:1fr}
  }
</style>
