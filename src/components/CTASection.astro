---
import { siteConfig } from '../config/site';
---
<section class="cta"><div class="container"><p class="eyebrow">Masz ładunek do przewiezienia?</p><h2>Powiedz co, skąd i dokąd.<br /><span>My zajmiemy się resztą.</span></h2><div class="cta-actions"><a class="btn btn-primary" href="/wycena/">Wyceń transport</a><a class="btn btn-secondary" href={`tel:${siteConfig.phone}`}>+48 514 948 373</a></div></div></section>
<style>.cta{padding:clamp(90px,13vw,180px) 0;background:linear-gradient(135deg,#131619,#08090a);border-top:1px solid var(--line)}.cta h2{font-size:clamp(3rem,7vw,8rem);line-height:.92;letter-spacing:-.055em;margin:20px 0 42px}.cta h2 span{color:var(--accent)}.cta-actions{display:flex;gap:12px;flex-wrap:wrap}</style>
