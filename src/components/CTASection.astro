---
import { siteConfig } from '../config/site';
---
<section class="cta"><div class="container cta-grid"><p class="eyebrow">Masz ładunek do przewiezienia?</p><h2>Powiedz co, skąd i dokąd.<br /><span>My zajmiemy się resztą.</span></h2><div class="cta-actions"><a class="btn btn-primary" href="/wycena/">Wyceń transport</a><a class="btn btn-secondary" href={`tel:${siteConfig.phone}`}>+48 514 948 373</a></div></div></section>
<style>
  .cta{padding:clamp(90px,11vw,160px) 0;background:linear-gradient(135deg,#131619,#08090a);border-top:1px solid var(--line)}
  .cta-grid{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:var(--grid-gap);align-items:end}
  .cta .eyebrow{grid-column:1 / span 3;margin:0 0 12px}
  .cta h2{grid-column:1 / -1;font-size:clamp(3rem,6.8vw,7.2rem);line-height:.92;letter-spacing:-.055em;margin:12px 0 0;max-width:11ch;text-wrap:balance}
  .cta h2 span{color:var(--accent)}
  .cta-actions{grid-column:8 / -1;display:flex;justify-content:flex-end;gap:12px;flex-wrap:wrap;margin-top:12px}
  @media(max-width:900px){.cta-actions{grid-column:7 / -1}}
  @media(max-width:760px){.cta-grid{grid-template-columns:1fr}.cta .eyebrow,.cta h2,.cta-actions{grid-column:auto}.cta h2{max-width:100%;font-size:clamp(2.7rem,13vw,4.8rem)}.cta-actions{justify-content:flex-start;margin-top:18px}}
</style>
