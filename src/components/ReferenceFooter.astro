---
import { siteConfig } from '../config/site';
import DistanceEstimator from './DistanceEstimator.astro';
import GoogleReviews from './GoogleReviews.astro';
const routeId = 'site-footer-route';
---
  <footer class="sht-footer site-footer">
    <div class="sht-shell sht-footer-top">
      <a href="/" class="sht-footer-logo">KALTRUCK <span>TRANSPORT HDS</span></a>
      <nav aria-label="Nawigacja w stopce">
        <a href="/transport-hds/">Usługi</a>
        <a href="/realizacje/">Realizacje</a>
        <a href="/o-nas/">O nas</a>
        <a href="/kontakt/">Kontakt</a>
      </nav>
      <div class="sht-socials">
        <a href={siteConfig.facebook} target="_blank" rel="noopener noreferrer">Facebook</a>
        <a href={siteConfig.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>
      </div>
    </div>
    <div class="sht-shell sht-route-wrapper">
      <details class="sht-route-details"><summary>SPRAWDŹ TRASĘ TRANSPORTU <span aria-hidden="true">+</span></summary>
        <DistanceEstimator instanceId={routeId} deferMap={true} />
      </details>
    </div>
    <div class="sht-shell sht-review-wrapper">
      <details class="sht-route-details sht-review-details" data-reference-reviews>
        <summary>OPINIE KLIENTÓW GOOGLE <span aria-hidden="true">+</span></summary>
        <GoogleReviews />
      </details>
    </div>
    <script is:inline>
      (() => {
        document.querySelectorAll('.sht-route-details:not(.sht-review-details)').forEach((details) => {
        details.addEventListener('toggle', () => {
          if (!details.open) return;
          details.querySelector('[data-google-route]')?.dispatchEvent(new CustomEvent('kaltruck:route-activate'));
        });
      });
      document.querySelectorAll('[data-reference-reviews]').forEach((details) => {
          details.addEventListener('toggle', () => {
            if (!details.open) return;
            const reviews = details.querySelector('[data-google-reviews]');
            reviews?.dispatchEvent(new CustomEvent('kaltruck:reviews-activate'));
          });
        });
      })();
    </script>
    <div class="sht-shell sht-footer-bottom">
      <span>© {new Date().getFullYear()} {siteConfig.legalName} · NIP: {siteConfig.nip}</span>
      <span>prophloc</span>
    </div>
  </footer>