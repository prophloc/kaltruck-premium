---
const links = [
  ['Usługi', '/transport-hds/'],
  ['Realizacje', '/realizacje/'],
  ['Sprzęt', '/sprzet/'],
  ['O nas', '/o-nas/'],
  ['Kontakt', '/kontakt/'],
] as const;
---
<div class="mobile-menu" id="mobile-menu" data-mobile-menu>
  <div class="mobile-menu__panel" role="dialog" aria-modal="true" aria-label="Menu główne">
    <button class="mobile-menu__close" type="button" aria-label="Zamknij menu" data-menu-close>×</button>
    <nav aria-label="Nawigacja mobilna">
      {links.map(([label, href]) => <a href={href}>{label}</a>)}
    </nav>
    <a class="btn btn-primary" href="/wycena/">Wyceń transport</a>
  </div>
</div>

<style>
  .mobile-menu { position: fixed; inset: 0; z-index: 70; background: rgba(5,6,7,.72); backdrop-filter: blur(12px); visibility: hidden; opacity: 0; transition: opacity .2s ease, visibility .2s ease; }
  .mobile-menu[data-open="true"] { visibility: visible; opacity: 1; }
  .mobile-menu__panel { position: absolute; right: 0; top: 0; width: min(90vw, 430px); height: 100%; padding: 90px 32px 36px; background: #0e1012; border-left: 1px solid var(--line); }
  .mobile-menu__close { position: absolute; top: 22px; right: 24px; width: 48px; height: 48px; border-radius: 50%; border: 1px solid var(--line); background: transparent; color: var(--text); font-size: 2rem; }
  nav { display: grid; gap: 8px; margin-bottom: 30px; }
  nav a { font-size: clamp(2rem, 9vw, 3.2rem); font-weight: 760; letter-spacing: -.04em; padding: 4px 0; }
  @media (min-width: 900px) { .mobile-menu { display: none; } }
</style>
