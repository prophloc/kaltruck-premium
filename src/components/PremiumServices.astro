---
const services = [
  {
    number: '01',
    type: 'Transport HDS',
    title: 'Kontenery. Dokładnie na swoim miejscu.',
    description: 'Odbiór, przewóz, rozładunek i ustawienie kontenerów mieszkalnych, biurowych oraz magazynowych.',
    href: '/transport-kontenerow/',
    image: 'https://hdsplock.pl/zdj/realizacje/transport-kontenerow-07.jpg',
    alt: 'Samochód HDS podczas transportu kontenera',
  },
  {
    number: '02',
    type: 'Budownictwo',
    title: 'Prefabrykaty i konstrukcje.',
    description: 'Transport i precyzyjne ustawianie elementów betonowych, stalowych oraz konstrukcyjnych.',
    href: '/transport-prefabrykatow/',
    image: 'https://hdsplock.pl/zdj/realizacje/prefabrykaty-betonowe-05.jpg',
    alt: 'Rozładunek prefabrykatu betonowego przy użyciu HDS',
  },
  {
    number: '03',
    type: 'Przemysł',
    title: 'Maszyny i urządzenia.',
    description: 'Bezpieczna organizacja transportu, podnoszenia i ustawiania ciężkich urządzeń.',
    href: '/transport-maszyn/',
    image: 'https://hdsplock.pl/zdj/realizacje/suwnice-przemys-owe-04.jpg',
    alt: 'Obsługa urządzenia przemysłowego za pomocą HDS',
  },
  {
    number: '04',
    type: 'Precyzyjny rozładunek',
    title: 'Ciężar zostaw nam.',
    description: 'Praca żurawiem samochodowym na miejscu dostawy, bez organizowania osobnego sprzętu.',
    href: '/rozladunek-hds/',
    image: 'https://hdsplock.pl/zdj/realizacje/stacje-transformatorowe-07.jpg',
    alt: 'Precyzyjne ustawianie ciężkiego urządzenia',
  },
  {
    number: '05',
    type: 'Transport specjalistyczny',
    title: 'Niecodzienne ładunki? Też.',
    description: 'Obsługa transportu i rozładunku nietypowych ładunków na terenie całej Polski.',
    href: '/transport-hds/',
    image: 'https://hdsplock.pl/zdj/realizacje/transport-przemys-owy-03.jpg',
    alt: 'Transport przemysłowy realizowany samochodem HDS',
  },
];
---
<section class="premium-services section" id="oferta" aria-labelledby="premium-services-heading">
  <div class="container">
    <div class="premium-services__intro">
      <div>
        <p class="eyebrow">01 / CO ROBIMY</p>
        <h2 id="premium-services-heading">Przewozimy.<br /><span>Podnosimy.</span><br />Ustawiamy.</h2>
      </div>
      <div class="premium-services__lead">
        <p>Od kontenera po maszynę przemysłową — łączymy transport i pracę HDS w jednej, zaplanowanej realizacji. Wiesz, kto odbierze ładunek, dowiezie go i ustawi we właściwym miejscu.</p>
        <a href="/transport-hds/">Poznaj naszą ofertę <span aria-hidden="true">↗</span></a>
      </div>
    </div>

    <div class="premium-services__grid">
      {services.map((service) => (
        <article class="premium-service">
          <img src={service.image} alt={service.alt} width="1200" height="900" loading="lazy" decoding="async" />
          <div class="premium-service__shade" aria-hidden="true"></div>
          <div class="premium-service__content">
            <div class="premium-service__meta"><span>{service.number} / 05</span><span>{service.type}</span></div>
            <div>
              <h3>{service.title}</h3>
              <p>{service.description}</p>
              <a href={service.href} aria-label={'Sprawdź usługę: ' + service.title}>Zobacz usługę <span aria-hidden="true">↗</span></a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="premium-services__footer">
      <p>Transport HDS / Płock / Mazowsze / Polska</p>
      <a href="/wycena/">Opowiedz nam, co trzeba przewieźć <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>

<style>
  .premium-services{background:#0b0d0e;overflow:hidden;border-top:1px solid rgba(215,180,106,.12);border-bottom:1px solid var(--line);padding-block:clamp(76px,8vw,124px)}
  .premium-services__intro{display:grid;grid-template-columns:minmax(0,1.12fr) minmax(0,.8fr);gap:clamp(32px,7vw,110px);align-items:end;margin-bottom:clamp(36px,4.5vw,65px)}
  .premium-services__intro .eyebrow{margin-bottom:24px}
  .premium-services__intro h2{margin:0;font-size:clamp(3.3rem,6.9vw,7.8rem);font-weight:820;letter-spacing:-.072em;line-height:.86;text-transform:uppercase;max-width:12ch;text-wrap:balance}
  .premium-services__intro h2 span{color:var(--accent)}
  .premium-services__lead{padding-bottom:6px}
  .premium-services__lead p{max-width:49ch;margin:0 0 27px;font-size:clamp(1.06rem,1.34vw,1.3rem);color:#c4c1b9;line-height:1.72}
  .premium-services__lead a,.premium-services__footer a{display:inline-flex;align-items:center;gap:18px;color:#f0d098;font-size:.91rem;font-weight:780;text-transform:uppercase;letter-spacing:.055em;border-bottom:1px solid rgba(215,180,106,.42);padding-bottom:11px}
  .premium-services__lead a span,.premium-services__footer a span{font-size:1.2rem}
  .premium-services__grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:16px}
  .premium-service{grid-column:span 2;position:relative;isolation:isolate;overflow:hidden;min-height:340px;border-radius:17px;background:#17191a;border:1px solid rgba(255,255,255,.13);transition:border-color .24s ease,transform .3s ease;display:flex;align-items:stretch}
  .premium-service:nth-child(-n+2){grid-column:span 3;min-height:470px}
  .premium-service img{position:absolute;inset:0;z-index:-2;width:100%;height:100%;object-fit:cover;transition:transform .7s cubic-bezier(.2,.7,.2,1)}
  .premium-service__shade{position:absolute;inset:0;z-index:-1;background:linear-gradient(180deg,rgba(4,6,7,.36),rgba(5,7,8,.24) 28%,rgba(5,7,8,.95) 100%)}
  .premium-service__content{width:100%;min-height:100%;display:flex;flex-direction:column;justify-content:space-between;padding:clamp(22px,2.7vw,36px);gap:55px}
  .premium-service__meta{display:flex;justify-content:space-between;align-items:start;gap:14px;color:#e0dcd1;font-size:.68rem;font-weight:750;letter-spacing:.13em;text-transform:uppercase}
  .premium-service__meta span:first-child{color:#f2ce8e}
  .premium-service h3{max-width:15ch;margin:0 0 11px;font-size:clamp(1.8rem,2.5vw,3.4rem);line-height:.98;letter-spacing:-.05em;text-shadow:0 2px 12px rgba(0,0,0,.4)}
  .premium-service p{max-width:40ch;margin:0 0 21px;color:#eee8df;font-size:.93rem;line-height:1.58}
  .premium-service a{display:inline-flex;align-items:center;gap:14px;color:#f6d596;font-size:.8rem;letter-spacing:.095em;font-weight:850;text-transform:uppercase}
  .premium-service a::after{content:'';position:absolute;inset:0}
  .premium-service a span{font-size:1.1rem}
  .premium-service:hover{transform:translateY(-4px);border-color:rgba(215,180,106,.5)}
  .premium-service:hover img{transform:scale(1.055)}
  .premium-service:focus-within{outline:2px solid var(--accent);outline-offset:3px}
  .premium-services__footer{display:flex;align-items:center;justify-content:space-between;gap:24px;margin-top:31px}
  .premium-services__footer p{margin:0;color:#8e918e;font-size:.74rem;letter-spacing:.14em;text-transform:uppercase}
  @media(max-width:900px){
    .premium-services__intro{grid-template-columns:1fr;gap:24px}
    .premium-services__grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:13px}
    .premium-service,.premium-service:nth-child(-n+2){grid-column:span 1;min-height:370px}
    .premium-service:last-child{grid-column:span 2;min-height:340px}
  }
  @media(max-width:620px){
    .premium-services{padding-block:62px}
    .premium-services__intro h2{font-size:clamp(2.85rem,11.9vw,4.8rem)}
    .premium-services__lead p{font-size:1rem}
    .premium-services__grid{grid-template-columns:1fr;gap:12px}
    .premium-service,.premium-service:nth-child(-n+2),.premium-service:last-child{grid-column:auto;min-height:340px}
    .premium-service h3{font-size:clamp(2rem,8vw,2.65rem)}
    .premium-service__content{padding:25px;gap:65px}
    .premium-services__footer{flex-direction:column;align-items:flex-start}
  }
  @media(prefers-reduced-motion:reduce){.premium-service,.premium-service img{transition:none}}
</style>
