---
import { siteConfig } from '../config/site';

const services = [
  {
    number: '01',
    category: 'TRANSPORT / HDS',
    title: 'Transport kontenerów',
    body: 'Odbiór, przewóz, rozładunek i ustawienie kontenerów magazynowych, biurowych i mieszkalnych.',
    href: '/transport-kontenerow/',
    image: 'https://hdsplock.pl/zdj/realizacje/transport-kontenerow-07.jpg',
    alt: 'Transport kontenera realizowany samochodem HDS'
  },
  {
    number: '02',
    category: 'BUDOWNICTWO / HDS',
    title: 'Prefabrykaty i konstrukcje',
    body: 'Transport i rozładunek prefabrykatów betonowych, stalowych elementów oraz ładunków dla budownictwa.',
    href: '/transport-prefabrykatow/',
    image: 'https://hdsplock.pl/zdj/realizacje/prefabrykaty-betonowe-05.jpg',
    alt: 'Rozładunek prefabrykatów betonowych żurawiem HDS'
  },
  {
    number: '03',
    category: 'PRZEMYSŁ / HDS',
    title: 'Maszyny i urządzenia',
    body: 'Transport sprzętu przemysłowego oraz urządzeń, których załadunek i ustawienie wymagają żurawia.',
    href: '/transport-maszyn/',
    image: 'https://hdsplock.pl/zdj/realizacje/suwnice-przemys-owe-04.jpg',
    alt: 'Specjalistyczne prace HDS przy maszynach i urządzeniach'
  }
];

const facts = [
  ['10+', 'LAT DOŚWIADCZENIA', '01'],
  ['12 t', 'UDŹWIG HDS DO', '02'],
  ['14 m', 'ZASIĘG RAMIENIA DO', '03'],
  ['POLSKA', 'OBSZAR DZIAŁANIA', '04'],
];

const reasons = [
  ['01', 'Transport i dźwig w jednym', 'Jeden zestaw realizuje przewóz oraz podnoszenie ładunku. Ograniczamy niepotrzebne przeładunki.'],
  ['02', 'Plan przed wyjazdem', 'Weryfikujemy masę i wymiary ładunku, dojazd, wymagany promień pracy i warunki podłoża.'],
  ['03', 'Ustawienie na miejscu', 'Nie kończymy pracy przy dostawie. Jeżeli warunki na to pozwalają, ustawiamy ładunek w docelowej lokalizacji.'],
  ['04', 'Zlecenia w całej Polsce', 'Bazujemy w Płocku i dojeżdżamy również do klientów w innych województwach.']
];
---
<div class="ht-page">
  <section class="ht-hero" aria-labelledby="ht-title" data-ht-hero>
    <div class="ht-hero-media" aria-hidden="true"></div>
    <div class="ht-hero-hatch" aria-hidden="true"></div>
    <div class="ht-container ht-hero-inner">
      <div class="ht-hero-upper">
        <span class="ht-rule-start"></span>
        <span>PROFESJONALNY TRANSPORT Z ŻURAWIEM</span>
        <span class="ht-hero-upper-index">KALTRUCK <span>/</span> PŁOCK, POLSKA</span>
      </div>
      <div class="ht-hero-copy">
        <div class="ht-lead-number" aria-hidden="true"><i></i><span>TRANSPORT HDS</span></div>
        <h1 id="ht-title">CIĘŻKI ŁADUNEK.<br /><em>PEWNY TRANSPORT.</em></h1>
        <p>Transport, rozładunek i precyzyjne ustawianie kontenerów, prefabrykatów i maszyn. Od Płocka po całą Polskę.</p>
        <div class="ht-hero-actions">
          <a class="ht-action-primary" href="/wycena/">ZAPYTAJ O WYCENĘ <span aria-hidden="true">↗</span></a>
          <a class="ht-action-plain" href="#ht-o-firmie">POZNAJ KALTRUCK <span aria-hidden="true">↓</span></a>
        </div>
      </div>
      <div class="ht-hero-foot">
        <span>TRANSPORT / HDS / ROZŁADUNEK</span>
        <span>01 — PRZEJDŹ NIŻEJ <span aria-hidden="true">↓</span></span>
      </div>
    </div>
  </section>

  <section class="ht-facts" aria-label="Możliwości i zakres KALTRUCK">
    <div class="ht-container ht-facts-grid">
      {facts.map(([value,label,index]) => <div class="ht-fact">
        <span class="ht-fact-index">{index}</span>
        <strong>{value}</strong>
        <span class="ht-fact-label">{label}</span>
      </div>)}
    </div>
  </section>

  <section class="ht-about" id="ht-o-firmie" aria-labelledby="ht-about-title">
    <div class="ht-container ht-about-grid">
      <div class="ht-about-visual">
        <div class="ht-image-frame">
          <img src="https://hdsplock.pl/zdj/realizacje/transport-przemys-owy-03.jpg" alt="Specjalistyczny transport przemysłowy HDS w realizacji KALTRUCK" width="1435" height="1080" loading="lazy" decoding="async" />
        </div>
        <div class="ht-image-label"><span>01 / NASZA PRACA</span><span>TRANSPORT SPECJALISTYCZNY</span></div>
        <div class="ht-image-corner" aria-hidden="true">K<span>—</span></div>
      </div>
      <div class="ht-about-copy">
        <p class="ht-kicker"><span class="ht-kicker-slash">/</span> POZNAJ NASZĄ FIRMĘ</p>
        <h2 id="ht-about-title">Z PŁOCKA.<br />W KAŻDE <span>MIEJSCE,</span> GDZIE POTRZEBNY JEST HDS.</h2>
        <p class="ht-about-lead">Przyjeżdżamy, podnosimy, przewozimy i ustawiamy. KALTRUCK łączy transport samochodowy z pracą żurawia HDS — bez zbędnego angażowania osobnego sprzętu do rozładunku.</p>
        <p>Obsługujemy klientów indywidualnych, budownictwo i przemysł. Każdą realizację planujemy w odniesieniu do wagi, gabarytów oraz warunków w miejscu odbioru i dostawy.</p>
        <div class="ht-text-actions">
          <a href="/o-nas/">WIĘCEJ O KALTRUCK <span aria-hidden="true">↗</span></a>
          <a href="/sprzet/">NASZ SPRZĘT <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="ht-services" id="ht-uslugi" aria-labelledby="ht-services-title">
    <div class="ht-container">
      <div class="ht-section-heading">
        <div>
          <p class="ht-kicker"><span class="ht-kicker-slash">/</span> ZAKRES USŁUG</p>
          <h2 id="ht-services-title">CO MOŻEMY<br /><span>DLA CIEBIE ZROBIĆ?</span></h2>
        </div>
        <div class="ht-section-heading-side">
          <p>Od pojedynczego kontenera po ciężkie elementy przemysłowe. Transport i rozładunek dopasowany do charakteru zlecenia.</p>
          <a href="/transport-hds/">PEŁNA OFERTA <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="ht-service-grid">
        {services.map((service) => <a class="ht-service" href={service.href} aria-label={`Poznaj usługę: ${service.title}`}>
          <div class="ht-service-media">
            <img src={service.image} alt={service.alt} width="1435" height="1080" loading="lazy" decoding="async"/>
            <span class="ht-service-number">{service.number} / 03</span>
            <span class="ht-service-arrow" aria-hidden="true">↗</span>
          </div>
          <div class="ht-service-info">
            <p>{service.category}</p>
            <h3>{service.title}</h3>
            <span>{service.body}</span>
            <strong>SPRAWDŹ USŁUGĘ <span aria-hidden="true">↗</span></strong>
          </div>
        </a>)}
      </div>
    </div>
  </section>

  <section class="ht-statement" aria-label="Kompleksowy transport HDS">
    <div class="ht-statement-media" aria-hidden="true"></div>
    <div class="ht-container ht-statement-inner">
      <p class="ht-kicker"><span class="ht-kicker-slash">/</span> PRECYZJA W TERENIE</p>
      <h2>NIE TYLKO<br />PRZEWOZIMY.<br /><em>USTAWIAMY.</em></h2>
      <p>Dysponujemy sprzętem HDS o udźwigu do 12 ton i zasięgu ramienia do 14 metrów. Możliwość konkretnego podnoszenia potwierdzamy po sprawdzeniu parametrów ładunku.</p>
      <a class="ht-action-primary" href="/rozladunek-hds/">POZNAJ ROZŁADUNEK HDS <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="ht-reasons" id="ht-atuty" aria-labelledby="ht-reasons-title">
    <div class="ht-container">
      <div class="ht-section-heading ht-reasons-heading">
        <div>
          <p class="ht-kicker"><span class="ht-kicker-slash">/</span> DLACZEGO KALTRUCK</p>
          <h2 id="ht-reasons-title">DOBRA LOGISTYKA.<br /><span>PRECYZYJNA ROBOTA.</span></h2>
        </div>
      </div>
      <div class="ht-reasons-grid">
        {reasons.map(([number,title,desc]) => <article class="ht-reason">
          <span class="ht-reason-number">{number} / 04</span>
          <div class="ht-reason-rule"></div>
          <h3>{title}</h3>
          <p>{desc}</p>
        </article>)}
      </div>
      <div class="ht-reasons-bridge">
        <a href="/realizacje/">ZOBACZ NASZE REALIZACJE <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="ht-contact" id="ht-kontakt" aria-labelledby="ht-contact-title">
    <div class="ht-container ht-contact-inner">
      <div class="ht-contact-primary">
        <p class="ht-kicker"><span class="ht-kicker-slash">/</span> KONTAKT Z KALTRUCK</p>
        <h2 id="ht-contact-title">MASZ ŁADUNEK<br />DO <em>PRZEWIEZIENIA?</em></h2>
        <p>Podaj rodzaj ładunku, masę, wymiary i lokalizację. Sprawdzimy warunki i możliwości transportu z HDS.</p>
        <a class="ht-action-primary" href="/wycena/">WYŚLIJ ZAPYTANIE <span aria-hidden="true">↗</span></a>
      </div>
      <div class="ht-contact-details">
        <div>
          <span>TELEFON</span>
          <a href={`tel:${siteConfig.phone}`}>+48 784 430 022</a>
        </div>
        <div>
          <span>E-MAIL</span>
          <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
        </div>
        <div>
          <span>BAZA TRANSPORTOWA</span>
          <a href={siteConfig.googleMapsUrl} target="_blank" rel="noopener noreferrer">{siteConfig.baseAddress} <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>
  </section>
</div>
