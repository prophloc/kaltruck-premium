---
const steps=[
  ['01', 'Kontakt', 'zapytanie'],
  ['02', 'Ocena ładunku', 'i warunków'],
  ['03', 'Wycena', 'i termin'],
  ['04', 'Transport', 'i ustawienie'],
];
---
<section class="process">
  <div class="container process-shell">
    <div class="process-heading">
      <p class="eyebrow">Prosty proces</p>
      <h2>Od telefonu do ustawienia ładunku.</h2>
    </div>
    <div class="steps">
      {steps.map(([n, firstLine, secondLine]) => (
        <div class="step" data-process-step>
          <div class="step-top">
            <span class="step-number" data-step-number>{n}</span>
            <span class="step-rule" aria-hidden="true"></span>
          </div>
          <h3 data-step-title><span>{firstLine}</span>{' '}<span>{secondLine}</span></h3>
        </div>
      ))}
    </div>
  </div>
</section>
<style>
  .process{padding:clamp(72px,7vw,102px) 0;background:#090b0c;border-bottom:1px solid var(--line)}
  .process-shell{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:var(--grid-gap);align-items:start}
  .process-heading{grid-column:1 / span 5}
  .process-heading .eyebrow{margin:0 0 16px}
  .process-heading h2{font-size:clamp(2.75rem,4.25vw,4.75rem);line-height:.96;letter-spacing:-.05em;margin:0;max-width:9ch;text-wrap:balance}
  .steps{grid-column:6 / -1;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));grid-auto-rows:1fr;gap:12px}
  .step{
    min-height:158px;
    padding:21px 24px 23px;
    display:grid;
    grid-template-rows:auto 1fr;
    border:1px solid rgba(255,255,255,.08);
    border-radius:12px;
    background:linear-gradient(145deg,rgba(255,255,255,.026),rgba(255,255,255,.008));
  }
  .step-top{display:flex;align-items:center;gap:12px;min-width:0}
  .step-number{
    display:inline-grid;
    place-items:center;
    min-width:34px;
    height:26px;
    padding:0 8px;
    border:1px solid rgba(215,180,106,.28);
    border-radius:999px;
    color:var(--accent);
    font-size:.68rem;
    font-weight:800;
    letter-spacing:.12em;
    line-height:1;
  }
  .step-rule{height:1px;flex:1;background:linear-gradient(90deg,rgba(215,180,106,.28),rgba(255,255,255,.035))}
  .step h3{align-self:end;font-size:clamp(1.25rem,1.55vw,1.72rem);line-height:1.04;margin:28px 0 0;max-width:none;letter-spacing:-.025em;text-wrap:normal}
  .step h3 span{display:block}
  @media(max-width:900px){.process-heading{grid-column:1 / span 5}.steps{grid-column:6 / -1}.step{min-height:148px;padding:20px 21px 22px}}
  @media(max-width:760px){
    .process{padding:52px 0}
    .process-shell{grid-template-columns:1fr;gap:30px}
    .process-heading,.steps{grid-column:auto}
    .process-heading h2{max-width:11ch;font-size:clamp(2.55rem,11vw,4rem)}
    .steps{grid-template-columns:1fr 1fr;gap:10px}
    .step{min-height:138px;padding:18px 19px 20px;border-radius:10px}
    .step h3{margin-top:22px;font-size:clamp(1.12rem,5vw,1.5rem);max-width:15ch}
    .step-number{min-width:32px;height:24px}
  }
  @media(max-width:460px){.steps{grid-template-columns:1fr}.step{min-height:124px}}
</style>
