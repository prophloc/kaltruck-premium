---
const steps=[['01','Kontakt / zapytanie'],['02','Ocena ładunku i warunków'],['03','Wycena i termin'],['04','Transport i ustawienie']];
---
<section class="process">
  <div class="container process-shell">
    <div class="process-heading">
      <p class="eyebrow">Prosty proces</p>
      <h2>Od telefonu do ustawienia ładunku.</h2>
    </div>
    <div class="steps">
      {steps.map(([n,t])=><div class="step"><span>{n}</span><h3>{t}</h3></div>)}
    </div>
  </div>
</section>
<style>
  .process{padding:clamp(72px,7vw,102px) 0;background:#090b0c;border-bottom:1px solid var(--line)}
  .process-shell{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:var(--grid-gap);align-items:start}
  .process-heading{grid-column:1 / span 5}
  .process-heading .eyebrow{margin:0 0 16px}
  .process-heading h2{font-size:clamp(2.75rem,4.25vw,4.75rem);line-height:.96;letter-spacing:-.05em;margin:0;max-width:9ch;text-wrap:balance}
  .steps{grid-column:6 / -1;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
  .step{
    min-height:150px;
    padding:22px 22px 24px;
    display:flex;
    flex-direction:column;
    justify-content:space-between;
    border:1px solid rgba(255,255,255,.08);
    border-radius:12px;
    background:linear-gradient(145deg,rgba(255,255,255,.025),rgba(255,255,255,.008));
  }
  .step span{color:var(--accent);font-size:.72rem;font-weight:700;letter-spacing:.14em}
  .step h3{font-size:clamp(1.25rem,1.55vw,1.72rem);line-height:1.08;margin:34px 0 0;max-width:12ch;letter-spacing:-.02em}
  @media(max-width:900px){.process-heading{grid-column:1 / span 5}.steps{grid-column:6 / -1}.step{min-height:140px;padding:20px}}
  @media(max-width:760px){
    .process{padding:52px 0}
    .process-shell{grid-template-columns:1fr;gap:30px}
    .process-heading,.steps{grid-column:auto}
    .process-heading h2{max-width:11ch;font-size:clamp(2.55rem,11vw,4rem)}
    .steps{grid-template-columns:1fr 1fr;gap:10px}
    .step{min-height:132px;padding:18px;border-radius:10px}
    .step h3{margin-top:24px;font-size:clamp(1.12rem,5vw,1.5rem)}
  }
  @media(max-width:460px){.steps{grid-template-columns:1fr}.step{min-height:116px}}
</style>
