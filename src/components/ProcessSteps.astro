---
const steps=[['01','Kontakt / zapytanie'],['02','Ocena ładunku i warunków'],['03','Wycena i termin'],['04','Transport i ustawienie']];
---
<section class="section process"><div class="container"><div class="process-heading"><p class="eyebrow">Prosty proces</p><h2 class="section-title">Od telefonu do ustawienia ładunku.</h2></div><div class="steps">{steps.map(([n,t])=><div class="step"><span>{n}</span><h3>{t}</h3></div>)}</div></div></section>
<style>
  .process-heading{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:var(--grid-gap);align-items:end}
  .process-heading .eyebrow{grid-column:1 / span 3;margin:0 0 8px}
  .process-heading .section-title{grid-column:4 / -1;max-width:12ch}
  .steps{display:grid;grid-template-columns:repeat(4,1fr);margin-top:clamp(42px,5vw,66px);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
  .step{padding:26px 24px 28px 0;border-right:1px solid var(--line);min-height:170px;display:flex;flex-direction:column;justify-content:space-between}
  .step + .step{padding-left:24px}
  .step:last-child{border-right:0}
  .step span{color:var(--accent);font-size:.75rem;letter-spacing:.14em}
  .step h3{font-size:clamp(1.2rem,1.7vw,1.85rem);line-height:1.08;margin:42px 0 0;max-width:12ch}
  @media(max-width:760px){.process-heading{grid-template-columns:1fr;gap:18px}.process-heading .eyebrow,.process-heading .section-title{grid-column:auto}.steps{grid-template-columns:1fr 1fr}.step{min-height:140px;padding:22px 18px 22px 0}.step + .step{padding-left:18px}.step:nth-child(2){border-right:0}.step:nth-child(-n+2){border-bottom:1px solid var(--line)}.step h3{margin-top:24px}}
</style>
