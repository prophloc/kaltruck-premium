<section class="cap-strip" aria-label="Możliwości firmy">
  <div class="container caps">
    <div><strong>10+ lat</strong><span>doświadczenia</span></div>
    <div><strong>do 12 t</strong><span>udźwigu HDS</span></div>
    <div><strong>do 14 m</strong><span>zasięgu ramienia</span></div>
    <div><strong>Polska</strong><span>obszar realizacji</span></div>
  </div>
</section>
<style>.cap-strip{border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:#0d0f11}.caps{display:grid;grid-template-columns:repeat(4,1fr)}.caps div{padding:30px 24px;border-right:1px solid var(--line)}.caps div:first-child{padding-left:0}.caps div:last-child{border-right:0}.caps strong,.caps span{display:block}.caps strong{font-size:1.5rem}.caps span{font-size:.82rem;color:var(--muted);margin-top:4px}@media(max-width:760px){.caps{grid-template-columns:1fr 1fr}.caps div{border-bottom:1px solid var(--line)}.caps div:nth-child(2){border-right:0}.caps div:first-child{padding-left:24px}}</style>
