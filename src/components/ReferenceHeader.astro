---
import { siteConfig } from '../config/site';
import ReferenceSideDrawers from './ReferenceSideDrawers.astro';
const current = Astro.url.pathname;
---
  <header class="sht-header" aria-label="Nagłówek witryny">
    <div class="sht-topline">
      <div class="sht-shell sht-topline-inner">
        <span>TRANSPORT SPECJALISTYCZNY I USŁUGI HDS</span>
        <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
      </div>
    </div>
    <div class="sht-navband">
      <div class="sht-shell sht-navinner">
        <a href="/" class="sht-logo" aria-label="KALTRUCK — strona główna">
          <img src="/brand/kaltruck-logo.svg" alt="KALTRUCK" width="2548" height="1305" />
        </a>
        <nav class="sht-nav" aria-label="Nawigacja główna">
          <a href="/transport-hds/" aria-current={current.startsWith("/transport-") || current.startsWith("/rozladunek-") || current.startsWith("/wynajem-") ? "page" : undefined}>USŁUGI</a>
          <a href="/realizacje/" aria-current={current==="/realizacje/"?"page":undefined}>REALIZACJE</a>
          <a href="/sprzet/" aria-current={current==="/sprzet/"?"page":undefined}>SPRZĘT</a>
          <a href="/o-nas/" aria-current={current==="/o-nas/"?"page":undefined}>O FIRMIE</a>
          <a href="/kontakt/" aria-current={current==="/kontakt/"?"page":undefined}>KONTAKT</a>
        </nav>
        <a class="sht-nav-phone" href={`tel:${siteConfig.phone}`} aria-label="Zadzwoń do KALTRUCK">+48 784 430 022</a>
      </div>
    </div>
  </header>


<ReferenceSideDrawers />
