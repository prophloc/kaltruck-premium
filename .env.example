# Canonical production origin, e.g. https://nowa-domena.pl
PUBLIC_SITE_URL=

# HTTPS endpoint receiving quote-form POST submissions.
# Leave empty until a real endpoint is configured; the UI then shows phone/e-mail fallback and disables submit.
PUBLIC_FORM_ENDPOINT=

# Browser key used only by the official Google Maps Embed API in the footer.
# Enable Maps Embed API and restrict the key to your production/preview site referrers.
PUBLIC_GOOGLE_MAPS_API_KEY=
