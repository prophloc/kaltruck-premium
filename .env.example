# Canonical production origin, e.g. https://nowa-domena.pl
PUBLIC_SITE_URL=

# HTTPS endpoint receiving quote-form POST submissions.
# Leave empty until a real endpoint is configured; the UI then shows phone/e-mail fallback and disables submit.
PUBLIC_FORM_ENDPOINT=

# Browser key for Google Maps Platform features used by this site.
# Enable Maps Embed API, Maps JavaScript API and Places API (New),
# then restrict the key to your production/preview site referrers and those APIs.
PUBLIC_GOOGLE_MAPS_API_KEY=

# Google Place ID for the KALTRUCK business profile used to load live reviews.
# The site has the current KALTRUCK Place ID as a fallback, but keeping it here makes deployments explicit.
PUBLIC_GOOGLE_PLACE_ID=ChIJhbMF0yh3HEcRVTtOsPxz9eM
